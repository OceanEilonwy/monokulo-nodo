        Card {
            height: 470px;
            VerticalLayout {
                padding-top: 24px;
                padding-left: 4px;
                padding-right: 4px;
                T {
                    height: 72px;
                    text: "     ✓  Everything else is running";
                    font-size: 30px;
                    font-weight: 700;
                    color: DP.ok;
                }
                Row {
                    name: "cuprated";
                    detail: "Syncing the Monero chain";

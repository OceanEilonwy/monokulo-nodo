    }
    if scene == "g-backups" || scene == "g-backing-up": Rectangle {
        GNav { tab: 3; lock: 1; }
        GHeader { crumbs: ["System"]; title: "Backups"; }
        GBody {
            top: 300px;
            if scene == "g-backups": GInfo {
                title: "Last backup 2 days ago";
                body: "To the USB drive \"NODO-BACKUP\" · 1.2 GB · locked with your passphrase";
                tone: 2;
                icon: "✓";
                primary: "Back up now";
                h: 170px;
            }
            if scene == "g-backing-up": GCard {
                height: 170px;
                VerticalLayout {
                    padding: 40px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 18px;
                        GSpinner { }
                        Tx { text: "Backing up · 640 MB of 1.2 GB"; font-size: 30px; font-weight: 600; color: G.bright; }
                        Rectangle { horizontal-stretch: 1; }
                        Tx { text: "about 1 min"; color: G.dim; font-size: 24px; }
                    }
                    GProgress { value: 0.53; }
                }
            }
            GList {
                rows: [
                    { t: "Automatically", s: "Every night at 03:00, when the drive is in", sw: 2 },
                    { t: "Keep", s: "The last 7 backups", v: "7", tone: 4, chev: true },
                    { t: "What's in it", s: "Apps' settings and data, sources, hosting · not the Monero chain", chev: true }
                ];
            }
        }
    }
    if scene == "g-restore": Rectangle {
        background: G.ground;
        Logo2 { x: (1920px - 180px) / 2; y: 60px; width: 180px; height: 180px; }
        GCard {
            x: (1920px - 1100px) / 2;
            y: 270px;
            width: 1100px;
            height: 700px;
            VerticalLayout {
                padding: 52px;
                spacing: 22px;
                Tx { text: "Restore onto this Nodo"; font-size: 40px; font-weight: 700; color: G.bright; }
                Tx { text: "Found a backup on the USB drive: monokulo-nodo, 2 days ago, 1.2 GB."; color: G.dim; }
                GInput { label: "The old Nodo's passphrase"; value: "x"; secret: true; trailing: "Show"; }
                Tx { text: "Comes back: 5 apps with their settings and data, 3 sources, hosting for 3 sites. The Monero chain syncs again."; color: G.dim; font-size: 24px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 20px;
                    alignment: end;
                    GButton { label: "Start fresh instead"; kind: 3; w: 300px; }
                    GButton { label: "Restore"; w: 240px; }
                }
            }
        }
    }
    if scene == "g-network" || scene == "g-wifi-join": Rectangle {
        GNav { tab: 3; lock: 1; }
        GHeader { crumbs: ["System"]; title: "Network"; }
        GBody {
            top: 300px;
            GList { rows: [{ t: "Cable", s: "Connected · 192.168.1.155 · fixed hardware address", v: "Connected", tone: 2 }]; }
            GCard {
                height: 440px;
                VerticalLayout {
                    padding: 8px;
                    GRow { r: { t: "Wi-Fi", s: "Not needed while the cable is connected", sw: 2 }; }
                    GRow { r: { t: "Home", s: "Strong · secured", v: "Joined", tone: 2 }; }
                    GRow { r: { t: "Corner-Cafe", s: "Good · secured", v: "", chev: true, hover: scene == "g-network" }; }
                    GRow { r: { t: "Neighbour-5G", s: "Weak · secured", chev: true }; last: true; }
                }
            }
            GList { rows: [{ t: "Bluetooth", s: "Lets a phone set the Nodo up without a cable", sw: 1 }]; }
        }
        if scene == "g-wifi-join": GScrim { }
        if scene == "g-wifi-join": Rectangle {
            x: (1920px - 1040px) / 2;
            y: 150px;
            width: 1040px;
            height: 440px;
            border-radius: 32px;
            background: G.card;
            border-width: 1px;
            border-color: #FFFFFF1E;
            drop-shadow-blur: 60px;
            drop-shadow-offset-y: 20px;
            drop-shadow-color: #000000E0;
            VerticalLayout {
                padding: 48px;
                spacing: 20px;
                Tx { text: "Join Corner-Cafe"; font-size: 36px; font-weight: 700; color: G.bright; }
                GInput { label: "Password"; value: "x"; secret: true; focused: true; trailing: "Show"; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 20px;
                    alignment: end;
                    GButton { label: "Cancel"; kind: 1; w: 220px; }
                    GButton { label: "Join"; w: 200px; }
                }
            }
        }
        if scene == "g-wifi-join": GKeyboard { }
    }
    if scene == "g-ssh-keys": Rectangle {
        GNav { tab: 3; lock: 1; }
        GHeader {
            crumbs: ["System"];
            title: "SSH keys";
            sub: "Computers that can log in to the Nodo over SSH.";
            GButton { label: "Add a key"; icon: "+"; w: 260px; lock: true; }
        }
        GBody {
            top: 340px;
            for k in [{ n: "henry@laptop", f: "SHA256:Qm4x…7Fd2 · ed25519", w: "Last used today" }, { n: "henry@desktop", f: "SHA256:9aKe…pL0c · ed25519", w: "Last used 3 days ago" }]: GCard {
                height: 140px;
                HorizontalLayout {
                    padding-left: 40px;
                    padding-right: 32px;
                    spacing: 24px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Tx { text: k.n; font-size: 28px; font-weight: 600; color: G.bright; }
                        Tx { text: k.f; font-family: G.mono; font-size: 22px; color: G.dim; }
                    }
                    Tx { text: k.w; font-size: 22px; color: G.dim; }
                    VerticalLayout { alignment: center; GButton { label: "Remove"; kind: 1; w: 190px; lock: true; } }
                }
            }
        }
        Note { text: "A key is easiest to add from the computer itself (ssh-copy-id); here you can paste one."; }
    }
    if scene == "g-screen": Rectangle {
        GNav { tab: 3; lock: 1; }
        GHeader { crumbs: ["System"]; title: "Screen"; sub: "The screen always shows your tiles. The Nodo logo is a tile too: add it in Arrange."; }
        GBody {
            top: 340px;
            GCard {
                height: 330px;
                VerticalLayout {
                    padding: 36px;
                    spacing: 18px;
                    HorizontalLayout {
                        height: 56px;
                        Tx { text: "Brightness"; font-size: 26px; font-weight: 600; color: G.bright; width: 420px; }
                        GSlider { value: 0.8; horizontal-stretch: 1; }
                        Tx { text: "80%"; color: G.dim; width: 100px; horizontal-alignment: right; }
                    }
                    HorizontalLayout {
                        height: 56px;
                        Tx { text: "Dim when idle to"; font-size: 26px; font-weight: 600; color: G.bright; width: 420px; }
                        GSlider { value: 0.2; horizontal-stretch: 1; }
                        Tx { text: "20%"; color: G.dim; width: 100px; horizontal-alignment: right; }
                    }
                    HorizontalLayout {
                        height: 80px;
                        Tx { text: "Back to the tiles after"; font-size: 26px; font-weight: 600; color: G.bright; width: 420px; }
                        GSegmented { options: ["1 min", "2 min", "5 min", "Never"]; selected: 1; horizontal-stretch: 1; }
                    }
                }
            }
            GList { rows: [{ t: "Screen PIN", s: "On · changes from this screen ask for it", chev: true }, { t: "Arrange the tiles", s: "Opens the tile screen in Arrange", chev: true }]; }
        }
    }

    // ---- blocking states
    if scene == "g-rejected": Rectangle {
        GNav { tab: 1; lock: 0; }
        GHeader { crumbs: ["Apps", "Get apps"]; title: "bob-photos"; }
        GBody {
            top: 300px;
            GInfo {
                title: "bob-photos can't be installed";
                body: "It asks to read every other app's data, which no app on the Nodo may do. Tell its publisher; nothing was changed.";
                tone: 3;
                icon: "✕";
                secondary: "Back";
                h: 210px;
            }
        }
    }
    if scene == "g-capability": Rectangle {
        GNav { tab: 1; lock: 0; }
        GHeader { crumbs: ["Apps", "Get apps"]; title: "feather-ws"; }
        GBody {
            top: 300px;
            GInfo {
                title: "feather-ws needs a Monero node first";
                body: "It reads from a Monero node on this Nodo. Install cuprated, then come back to feather-ws.";
                tone: 5;
                icon: "i";
                primary: "Install cuprated";
                secondary: "Back";
                lock: true;
                h: 210px;
            }
        }
    }
    if scene == "g-no-drive": Rectangle {
        GNav { tab: 0; lock: 0; }
        GHeader { crumbs: []; title: "Good afternoon"; }
        GBody {
            top: 300px;
            GInfo {
                title: "The data drive isn't connected";
                body: "Your apps keep their data on the SSD, so they can't start without it. Check the drive is seated in the Nodo, then check again. Nothing has been lost.";
                tone: 1;
                icon: "▲";
                primary: "Check again";
                h: 230px;
            }
        }
    }

    // ---- unlocking changes
    if scene == "g-pin" || scene == "g-pin-wrong": Rectangle {
        GNav { tab: 1; lock: 0; }
        GHeader { crumbs: ["Apps"]; title: "mk-pay"; sub: "Payments for your shop"; }
        PinPad { state: scene == "g-pin" ? 0 : 1; }
        if scene == "g-pin-wrong": Note { text: "A wrong PIN shakes the dots (300 ms) and clears them for another go. There is no limit: only someone at the screen can try."; }
    }
    if scene == "g-no-pin": Rectangle {
        GNav { tab: 3; lock: 2; }
        GHeader { crumbs: ["System", "Screen"]; title: "Screen PIN"; }
        GBody {
            top: 300px;
            GInfo {
                title: "Changes from this screen are off";
                body: "Anyone near the Nodo can touch its screen, so it shows everything but changes nothing until you choose a screen PIN. Choose one from a computer: ssh into the Nodo, then System › Screen › Screen PIN (needs the device passphrase).";
                tone: 5;
                icon: "i";
                h: 260px;
            }
            GInfo {
                title: "How it protects you";
                body: "Only the screen itself can check a PIN, so nothing else on the Nodo can guess it. Changes lock again after a few minutes without a touch. Shut down always works.";
                tone: 4;
                h: 170px;
            }
        }
    }

    // ---- the widget sheet: every control and its states
    if scene == "g-widgets": Rectangle {
        Tx { x: 64px; y: 40px; height: 60px; text: "Controls and their states"; font-size: 44px; font-weight: 700; color: G.bright; }
        GridLayout {
            x: 64px;
            y: 140px;
            width: 1792px;
            spacing: 28px;
            Row {
                GButton { label: "Primary"; }
                GButton { label: "Hover"; state: 1; }
                GButton { label: "Pressed"; state: 2; }
                GButton { label: "Disabled"; state: 3; }
                GButton { label: "Remove"; kind: 2; }
                GButton { label: "Secondary"; kind: 1; }
            }
            Row {
                GButton { label: "Locked"; lock: true; }
                GButton { label: "Back"; kind: 3; }
                GButton { label: "Manage"; icon: "☰"; kind: 1; }
                Rectangle { VerticalLayout { alignment: center; GSwitch { on: true; } } }
                Rectangle { VerticalLayout { alignment: center; GSwitch { on: false; } } }
                GStepper { value: "10"; }
            }
        }
        HorizontalLayout {
            x: 64px;
            y: 400px;
            width: 1792px;
            height: 160px;
            spacing: 28px;
            GInput { label: "Text"; value: ""; placeholder: "Placeholder"; }
            GInput { label: "Focused"; value: "Corner Café"; focused: true; }
            GInput { label: "Error"; value: "48daf1r…"; mono: true; error: "Not a Monero address"; }
        }
        HorizontalLayout {
            x: 64px;
            y: 600px;
            width: 1792px;
            height: 120px;
            spacing: 28px;
            GCombo { label: "Dropdown"; value: "EUR"; sub: "Euro"; }
            GCombo { label: "Open"; value: "cuprated"; open: true; }
            VerticalLayout {
                spacing: 10px;
                Tx { text: "Segmented"; font-size: 22px; color: G.dim; height: 30px; }
                GSegmented { options: ["1 min", "2 min", "5 min"]; selected: 1; }
            }
        }
        HorizontalLayout {
            x: 64px;
            y: 780px;
            width: 1792px;
            height: 80px;
            spacing: 40px;
            VerticalLayout { alignment: center; GSlider { value: 0.6; width: 500px; } }
            VerticalLayout { alignment: center; GProgress { value: 0.45; width: 500px; } }
            VerticalLayout { alignment: center; GSpinner { } }
        }
        GToast { y: 900px; text: "Saved · mk-pay restarted with the new settings"; tone: 2; action: "Undo"; }
    }
}

# FriendlyElec NanoPC-T6N, booted from microSD. The eMMC and existing SSD data are left alone.
BOARD_ARCH=aarch64
# The platform: the helper, TUI, health daemon and nodo-confine (nodo-tools), and the web proxy,
# dynamic DNS and local address services. The helper enables the web services when sites ask for
# them. Monokulo is a feed app, installed through the helper, so it is not part of the image.
BOARD_PACKAGES="linux-nanopc-t6n linux-firmware-network nodo-tools nodo-caddy nodo-ddns nodo-localnet"
# Started at boot, besides the base services: the helper the TUI talks to, the health daemon and
# the automatic update timer, which does nothing until the owner enables updates for a package.
BOARD_SERVICES="nodo-helper nodo-healthd nodo-autoupdate"
# The vendor kernel cannot run under QEMU, so a stock kernel runs the configure step.
BOARD_STAGE_KERNEL=linux6.18
BOARD_STAGE_CONSOLE=ttyAMA0
BOARD_QEMU="qemu-system-aarch64 -M virt -cpu max"
BOARD_STAGE1_MODULES="virtio_blk"
BOARD_CONSOLE=ttyFIQ0
BOARD_ROOT=/dev/mmcblk0p8
BOARD_FSTAB_EXTRA="PARTLABEL=NODO_BLOCKCHAIN /media/monero xfs defaults,noatime,nofail 0 0"
# The vendor kernel may not load compressed firmware.
BOARD_DECOMPRESS_FIRMWARE=1
BOARD_MKDIRS="/media/monero"
BOARD_DRACUT_DRIVERS=""
BOARD_FIRMWARE_IGNORE="linux sof-firmware alsa-firmware linux-firmware linux-firmware-amd linux-firmware-broadcom linux-firmware-intel linux-firmware-nvidia linux-firmware-qualcomm"
# Keep only the Realtek firmware the 2.5GbE port may ask for.
BOARD_NOEXTRACT="/usr/lib/firmware/* !/usr/lib/firmware/rtl_nic/rtl8125* /usr/lib/modules/*/kernel/sound/* /usr/lib/modules/*/kernel/drivers/media/*"
# Pinned FriendlyElec tooling that provides the bootloader for this board family.
BOARD_SDFUSE_COMMIT=430f0c0
BOARD_MAX_ROOTFS_MB=500

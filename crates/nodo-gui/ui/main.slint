// nodo-gui: the built-in screen's tiles and the device console (docs/SCREEN.md).
//
// The design is docs/design/device-console/*.dc.html (Glance, PowerOff, ShuttingDown for this
// file; the console is ui/console.slint), drawn at half size: every measure here is the design's
// doubled. Rust computes every rectangle a finger can hit on the tiles screen (src/geometry.rs)
// and passes it in; this file only draws. One TouchArea over the whole window hands every press,
// drag and release to Rust.

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import { ConsoleView, Icon, Icons, Touch, CAlert, CTile, CStatus, CWeb, CService, CKv, CServices, CStep, CNetwork, CDevice, CKeyboard, CPin, CReset, CDialog, CWifi, CWifiSheet, CLogo } from "console.slint";
export { Touch, CAlert, CTile, CStatus, CWeb, CService, CKv, CServices, CStep, CNetwork, CDevice, CKeyboard, CPin, CReset, CDialog, CWifi, CWifiSheet, CLogo }

export global Palette {
    out property <color> ground: #000000;
    out property <color> card: #0d0d0d;
    out property <color> button: #1a1a1a;
    out property <color> fg: #f2f2f2;
    out property <color> bright: #f2f2f2;
    out property <color> dim: #b3b3b3;
    out property <color> border: #262626;
    out property <color> track: #262626;
    out property <color> ok: #5fd3a8;
    out property <color> accent: #ff6600;
    out property <color> warm: #ff8c3a;
    out property <color> err: #ffa194;
    out property <color> neg: #ff9a8c;
    out property <color> neg-fill: #2a1513;
    out property <color> stop: #c62828;
}

export struct RowView {
    label: string,
    value: string,
}

export struct TileView {
    x: length,
    y: length,
    w: length,
    h: length,
    title: string,
    title-color: color,
    package: string,
    dot: bool,
    dot-color: color,
    outline: color,
    outline-width: length,
    big: string,
    unit: string,
    big-color: color,
    // One grid row tall: the design's smaller value.
    compact: bool,
    bar-shown: bool,
    bar: float,
    bar-color: color,
    rows: [RowView],
    value-color: color,
    series: [float],
    series-color: color,
    note: string,
    note-color: color,
    // "waiting for cuprated", or why the panel failed, in place of values.
    message: string,
    message-color: color,
    // Arranging: the tile shows only its name and size.
    arranging: bool,
    selected: bool,
    size-text: string,
    // The built-in Nodo logo tile: 0 a panel, 1 drawn, 2 the boot splash's block logo.
    logo: int,
    logo-image: image,
    logo-name: bool,
}

export struct CellView {
    x: length,
    y: length,
    w: length,
    h: length,
}

// kind: 0 plain, 1 shut down (red on dark red), 2 light (as plain), 3 save (orange), 4 undo
// (orange outline), 5 shut down for sure (red), 6 a large choice on the power screen, 7 the lit
// lock (orange). icon: 0 none, 1 the three lines, 2 sliders (Manage), 3 grid (Arrange), 4 lock,
// 5 power, 6 cross, 7 restart. A button without a label shows its icon alone.
export struct ButtonView {
    x: length,
    y: length,
    w: length,
    h: length,
    label: string,
    count: string,
    sub: string,
    kind: int,
    icon: int,
}

export struct PickerRowView {
    heading: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    title: string,
    detail: string,
    sizes: string,
    pw: int,
    ph: int,
    highlighted: bool,
}

export struct StepView {
    mark: string,
    mark-color: color,
    name: string,
    name-color: color,
    state: string,
    state-color: color,
    time: string,
}

export struct GhostView {
    shown: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    title: string,
    size-text: string,
}

// A rounded rectangle drawn with dashes, as the design's free cells and landing place.
component DashedBox inherits Rectangle {
    in property <color> dash-color;
    in property <length> thickness: 4px;
    in property <length> r: 20px;
    property <length> dash: 16px;
    property <length> gap: 12px;
    property <int> across: Math.max(0, Math.floor((self.width - 2 * r + gap) / (dash + gap)));
    property <int> down: Math.max(0, Math.floor((self.height - 2 * r + gap) / (dash + gap)));
    property <length> across-start: r + (self.width - 2 * r - (across * (dash + gap) - gap)) / 2;
    property <length> down-start: r + (self.height - 2 * r - (down * (dash + gap) - gap)) / 2;
    for i in across: Rectangle {
        x: across-start + i * (dash + gap);
        y: 0;
        width: dash;
        height: thickness;
        background: dash-color;
    }
    for i in across: Rectangle {
        x: across-start + i * (dash + gap);
        y: parent.height - thickness;
        width: dash;
        height: thickness;
        background: dash-color;
    }
    for i in down: Rectangle {
        x: 0;
        y: down-start + i * (dash + gap);
        width: thickness;
        height: dash;
        background: dash-color;
    }
    for i in down: Rectangle {
        x: parent.width - thickness;
        y: down-start + i * (dash + gap);
        width: thickness;
        height: dash;
        background: dash-color;
    }
    // The four corners, solid quarter circles.
    Path {
        x: 0;
        y: 0;
        width: r;
        height: r;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 2 20 A 18 18 0 0 1 20 2";
        stroke: dash-color;
        stroke-width: thickness;
    }
    Path {
        x: parent.width - r;
        y: 0;
        width: r;
        height: r;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 0 2 A 18 18 0 0 1 18 20";
        stroke: dash-color;
        stroke-width: thickness;
    }
    Path {
        x: 0;
        y: parent.height - r;
        width: r;
        height: r;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 2 0 A 18 18 0 0 0 20 18";
        stroke: dash-color;
        stroke-width: thickness;
    }
    Path {
        x: parent.width - r;
        y: parent.height - r;
        width: r;
        height: r;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 18 0 A 18 18 0 0 1 0 18";
        stroke: dash-color;
        stroke-width: thickness;
    }
}

// ⇲: an arrow into the bottom-right corner, which JetBrains Mono does not have either.
component GripIcon inherits Path {
    width: 44px;
    height: 44px;
    viewbox-width: 44;
    viewbox-height: 44;
    commands: "M 6 6 L 30 30 M 30 14 L 30 30 L 14 30 M 40 4 L 40 40 L 4 40";
    stroke: Palette.ground;
    stroke-width: 5px;
}

component Btn inherits Rectangle {
    in property <ButtonView> b;
    property <bool> large: b.kind == 5 || b.kind == 6;
    property <color> text-color: b.kind == 3 ? #000000 : b.kind == 5 ? #ffffff : b.kind == 1 ? Palette.neg : b.kind == 4 || b.kind == 7 ? Palette.warm : Palette.fg;
    property <string> path: b.icon == 2 ? Icons.device : b.icon == 3 ? Icons.services : b.icon == 4 ? Icons.lock : b.icon == 5 ? Icons.power : b.icon == 6 ? Icons.cross : b.icon == 7 ? Icons.restart : "M4 6h16 M4 12h16 M4 18h16";
    x: b.x;
    y: b.y;
    width: b.w;
    height: b.h;
    border-radius: large ? 44px : 32px;
    border-width: b.kind == 4 ? 4px : b.kind == 6 ? 4px : 0px;
    border-color: b.kind == 4 ? Palette.accent : Palette.border;
    background: b.kind == 3 ? Palette.accent : b.kind == 5 ? Palette.stop : b.kind == 1 ? Palette.neg-fill : b.kind == 4 ? transparent : b.kind == 6 ? Palette.card : Palette.button;
    if large: VerticalLayout {
        alignment: center;
        spacing: 20px;
        if b.icon > 0: HorizontalLayout {
            alignment: center;
            Icon {
                d: path;
                size: 72px;
                tint: b.icon == 7 ? Palette.warm : text-color;
            }
        }
        Text {
            text: b.label;
            font-family: "Inter";
            font-size: 38px;
            font-weight: 600;
            color: text-color;
            horizontal-alignment: center;
        }
    }
    if !large: HorizontalLayout {
        alignment: center;
        spacing: 16px;
        if b.icon > 0: VerticalLayout {
            alignment: center;
            Icon {
                d: path;
                size: 44px;
                tint: text-color;
            }
        }
        if b.label != "": Text {
            text: b.label;
            font-family: "Inter";
            font-size: 36px;
            font-weight: 600;
            color: text-color;
            vertical-alignment: center;
        }
        if b.count != "": Text {
            text: b.count;
            font-family: "JetBrains Mono";
            font-size: 32px;
            color: b.kind == 3 ? #000000 : Palette.dim;
            vertical-alignment: center;
        }
    }
}

component Sparkline inherits Rectangle {
    in property <[float]> values;
    in property <color> bar-color;
    property <length> step: values.length > 0 ? self.width / values.length : 0;
    for v[i] in values: Rectangle {
        x: i * step;
        width: Math.max(1px, step - 4px);
        height: Math.max(2px, parent.height * v);
        y: parent.height - self.height;
        background: bar-color;
    }
}

component Tile inherits Rectangle {
    in property <TileView> t;
    x: t.x;
    y: t.y;
    width: t.w;
    height: t.h;
    border-radius: 44px;
    border-width: t.outline-width;
    border-color: t.outline;
    // The logo tile is a wallpaper: no card behind it.
    background: t.logo > 0 && !t.arranging ? Palette.ground : Palette.card;
    clip: true;

    if t.logo > 0 && !t.arranging: VerticalLayout {
        alignment: center;
        spacing: 12px;
        property <length> side: min(t.w, t.h - (t.logo-name ? 80px : 0px)) * 0.82;
        HorizontalLayout {
            alignment: center;
            if t.logo == 1: Image {
                source: @image-url("logo.svg");
                width: side;
                height: side;
            }
            if t.logo == 2: Image {
                source: t.logo-image;
                image-rendering: pixelated;
                width: side;
                height: side;
            }
        }
        if t.logo-name: Text {
            text: t.logo == 2 ? "n o d o" : "nodo";
            horizontal-alignment: center;
            font-size: min(56px, side * 0.14);
            font-weight: 700;
            letter-spacing: t.logo == 2 ? 0px : 6px;
            color: Palette.accent;
        }
    }

    // Title row: the name in capitals and a status dot.
    Text {
        x: 40px;
        y: 20px;
        width: parent.width - 100px;
        text: t.title;
        font-family: "Inter";
        font-size: 30px;
        font-weight: 600;
        letter-spacing: 2px;
        color: t.title-color;
        overflow: elide;
    }
    if t.dot && !t.arranging: Rectangle {
        x: parent.width - 40px - self.width;
        y: 34px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: t.dot-color;
    }

    if t.arranging: VerticalLayout {
        x: 40px;
        y: 68px;
        width: parent.width - 80px;
        alignment: start;
        Text {
            text: t.size-text;
            font-family: "Inter";
            font-size: 30px;
            color: t.selected ? Palette.accent : Palette.dim;
            wrap: word-wrap;
        }
    }
    if t.arranging && t.selected: Text {
        x: 40px;
        y: parent.height - 24px - self.height;
        text: "drag to move";
        font-family: "Inter";
        font-size: 30px;
        color: Palette.dim;
    }
    if t.arranging && t.selected: Rectangle {
        x: parent.width - 104px;
        y: parent.height - 104px;
        width: 104px;
        height: 104px;
        background: Palette.accent;
        border-top-left-radius: 44px;
        border-bottom-right-radius: 44px;
        GripIcon { }
    }

    if !t.arranging: VerticalLayout {
        x: 40px;
        y: 68px;
        width: parent.width - 80px;
        height: parent.height - 68px - 16px;
        alignment: start;
        spacing: 0px;
        if t.message != "": Text {
            text: t.message;
            font-family: "Inter";
            font-size: 30px;
            color: t.message-color;
            wrap: word-wrap;
        }
        if t.big != "": HorizontalLayout {
            alignment: start;
            spacing: 16px;
            padding-top: 6px;
            Text {
                text: t.big;
                font-size: t.compact ? 60px : 88px;
                font-weight: 700;
                color: t.big-color;
                vertical-alignment: bottom;
                overflow: elide;
            }
            if t.unit != "": VerticalLayout {
                alignment: end;
                padding-bottom: t.compact ? 8px : 18px;
                Text {
                    text: t.unit;
                    font-family: "Inter";
                    font-size: 30px;
                    color: Palette.dim;
                }
            }
        }
        if t.bar-shown: Rectangle {
            height: 22px;
            Rectangle {
                y: 6px;
                height: 16px;
                border-radius: 8px;
                background: Palette.track;
            }
            Rectangle {
                x: 0;
                y: 6px;
                height: 16px;
                border-radius: 8px;
                width: parent.width * Math.min(1, Math.max(0, t.bar));
                background: t.bar-color;
            }
        }
        if t.rows.length > 0: Rectangle {
            height: 14px;
        }
        for row in t.rows: HorizontalLayout {
            height: 42px;
            spacing: 16px;
            Text {
                text: row.label;
                font-family: "Inter";
                font-size: 32px;
                color: Palette.dim;
                overflow: elide;
            }
            Text {
                text: row.value;
                font-size: 32px;
                color: t.value-color;
                horizontal-alignment: right;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        if t.note != "": Text {
            text: t.note;
            font-family: "Inter";
            font-size: 30px;
            color: t.note-color;
            overflow: elide;
        }
    }
    if !t.arranging && t.series.length > 0: Sparkline {
        x: 40px;
        y: parent.height - 52px - 48px;
        width: parent.width - 80px;
        height: 48px;
        values: t.series;
        bar-color: t.series-color;
    }
    if !t.arranging && t.package != "": Text {
        x: parent.width - 40px - self.width;
        y: parent.height - 12px - self.height;
        text: t.package;
        font-family: "Inter";
        font-size: 30px;
        color: Palette.dim;
    }
}

component PickerRow inherits Rectangle {
    in property <PickerRowView> line;
    x: line.x;
    y: line.y;
    width: line.w;
    height: line.h;
    if line.heading: Text {
        x: 0;
        y: parent.height - self.height - 8px;
        text: line.title;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: 1.3px;
        color: Palette.dim;
    }
    if !line.heading: Rectangle {
        // The row's bottom rule.
        Rectangle {
            x: 0;
            y: parent.height - 2px;
            height: 2px;
            background: Palette.track;
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 36px;
            alignment: stretch;
            // A small picture of the panel's starting size on the 8 x 4 grid.
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8 * 18px + 7 * 4px;
                    height: 4 * 18px + 3 * 4px;
                    for i in 32: Rectangle {
                        x: Math.mod(i, 8) * 22px;
                        y: Math.floor(i / 8) * 22px;
                        width: 18px;
                        height: 18px;
                        background: Math.mod(i, 8) < line.pw && Math.floor(i / 8) < line.ph ? Palette.fg : Palette.track;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 6px;
                Text {
                    text: line.title;
                    font-size: 36px;
                    font-weight: 700;
                    color: line.highlighted ? Palette.accent : Palette.bright;
                    overflow: elide;
                }
                Text {
                    text: line.detail;
                    font-size: 30px;
                    color: Palette.dim;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    width: 260px;
                    text: line.sizes;
                    font-size: 30px;
                    color: Palette.dim;
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 240px;
                    height: 96px;
                    border-radius: 32px;
                    background: Palette.button;
                    Text {
                        text: "+ Add";
                        font-size: 36px;
                        font-weight: 700;
                        color: Palette.fg;
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    width: 1920px;
    height: 1080px;
    background: Palette.ground;
    default-font-family: "JetBrains Mono";
    title: "nodo-gui";

    // 0 tiles, 1 arranging, 2 adding a panel, 3 the power screen, 4 shutting down, 5 off.
    in property <int> mode: 0;
    in property <string> host: "monokulo-nodo";
    in property <string> address;
    in property <string> day;
    in property <string> time;
    // Arranging's line in the top bar: a hint in grey or a refusal in orange.
    in property <string> hint;
    in property <bool> hint-is-warning;
    in property <length> header-text-width: 1000px;
    in property <[TileView]> tiles;
    in property <[CellView]> free-cells;
    in property <bool> target-shown;
    in property <CellView> target;
    in property <GhostView> ghost;
    in property <[ButtonView]> buttons;
    in property <[PickerRowView]> picker;
    in property <string> picker-hint;
    // Said under the power screen's choices, such as why Restart did nothing.
    in property <string> power-note;
    in property <string> shutdown-title;
    in property <string> shutdown-subtitle;
    in property <bool> shutdown-failed;
    in property <[StepView]> steps;
    in property <float> progress;
    in property <string> progress-note;

    callback pointer-down(length, length);
    callback pointer-move(length, length);
    callback pointer-up();
    // The key's text and whether shift was held; returns whether it was used.
    callback key(string, bool) -> bool;

    // The console, over the tiles while open (console.slint).
    in property <bool> c-open;
    in property <int> c-page;
    in property <int> c-overlay;
    in property <CStatus> c-status;
    in property <CWeb> c-web;
    in property <CServices> c-services;
    in property <CNetwork> c-network;
    in property <CDevice> c-device;
    in property <CKeyboard> c-keyboard;
    in property <CPin> c-pin;
    in property <CReset> c-reset;
    in property <CDialog> c-dialog;
    in property <CWifiSheet> c-wifi;
    in property <CLogo> c-logo;
    in property <string> c-toast;
    in property <bool> c-toast-error;
    callback c-act(string);
    callback c-key(string);

    // The top bar, left of its buttons: the device and the clock, or what arranging is doing.
    HorizontalLayout {
        x: 40px;
        y: 32px;
        width: header-text-width;
        height: 112px;
        spacing: 32px;
        alignment: mode == 0 ? LayoutAlignment.stretch : LayoutAlignment.start;
        if mode == 0: VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("logo.svg");
                width: 80px;
                height: 80px;
            }
        }
        if mode == 0: VerticalLayout {
            alignment: center;
            Text {
                text: host;
                font-family: "Inter";
                font-size: 40px;
                font-weight: 700;
                color: Palette.fg;
            }
            Text {
                text: address;
                font-size: 30px;
                color: Palette.dim;
                overflow: elide;
            }
        }
        if mode == 0: HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 20px;
            Text {
                text: time;
                font-size: 60px;
                font-weight: 700;
                color: Palette.fg;
                vertical-alignment: center;
            }
            Text {
                text: day;
                font-family: "Inter";
                font-size: 30px;
                color: Palette.dim;
                vertical-alignment: center;
            }
        }
        if mode == 1: VerticalLayout {
            alignment: center;
            Rectangle {
                background: Palette.accent;
                border-radius: 24px;
                width: badge.preferred-width + 48px;
                height: 72px;
                badge := Text {
                    text: "Arrange";
                    font-family: "Inter";
                    font-size: 36px;
                    font-weight: 700;
                    color: #000000;
                }
            }
        }
        if mode == 1: Text {
            text: hint;
            font-family: "Inter";
            font-size: 30px;
            color: hint-is-warning ? Palette.warm : Palette.dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if mode == 2: Text {
            text: "Add a panel";
            font-family: "Inter";
            font-size: 48px;
            font-weight: 700;
            color: Palette.bright;
            vertical-alignment: center;
        }
        if mode == 2: Text {
            text: picker-hint;
            font-family: "Inter";
            font-size: 30px;
            color: hint-is-warning ? Palette.warm : Palette.dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    if mode <= 1: Rectangle {
        for c in free-cells: DashedBox {
            x: c.x;
            y: c.y;
            width: c.w;
            height: c.h;
            r: 44px;
            dash-color: Palette.track;
        }
        for t in tiles: Tile {
            t: t;
        }
        if target-shown: DashedBox {
            x: target.x;
            y: target.y;
            width: target.w;
            height: target.h;
            r: 44px;
            dash-color: Palette.accent;
        }
        if ghost.shown: Rectangle {
            x: ghost.x;
            y: ghost.y;
            width: ghost.w;
            height: ghost.h;
            border-radius: 44px;
            border-width: 2px;
            border-color: Palette.dim;
            background: #f2f2f218;
            opacity: 0.85;
            Text {
                x: 40px;
                y: 20px;
                text: ghost.title;
                font-family: "Inter";
                font-size: 30px;
                font-weight: 600;
                letter-spacing: 2px;
                color: Palette.fg;
            }
            Text {
                x: 40px;
                y: 68px;
                text: ghost.size-text;
                font-family: "Inter";
                font-size: 30px;
                color: Palette.dim;
            }
        }
    }

    if mode == 2: Rectangle {
        for row in picker: PickerRow {
            line: row;
        }
    }

    // The power screen (PowerOff.dc.html); its three choices are buttons from Rust.
    if mode == 3: Rectangle {
        Icon {
            x: (parent.width - self.width) / 2;
            y: 170px;
            d: Icons.power;
            size: 112px;
            tint: Palette.neg;
        }
        Text {
            x: 0;
            y: 310px;
            width: parent.width;
            horizontal-alignment: center;
            text: "Turn off the Nodo?";
            font-family: "Inter";
            font-size: 68px;
            font-weight: 700;
            color: Palette.bright;
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 418px;
            width: 1120px;
            horizontal-alignment: center;
            text: "Every service stops, and the web admin goes offline. After a restart, encrypted services wait until you unlock again.";
            font-family: "Inter";
            font-size: 36px;
            color: Palette.dim;
            wrap: word-wrap;
        }
        Text {
            x: 0;
            y: 886px;
            width: parent.width;
            horizontal-alignment: center;
            text: "Safe to unplug once the screen goes dark.";
            font-family: "Inter";
            font-size: 30px;
            color: Palette.dim;
        }
        if power-note != "": Text {
            x: 0;
            y: 950px;
            width: parent.width;
            horizontal-alignment: center;
            text: power-note;
            font-family: "Inter";
            font-size: 30px;
            color: Palette.warm;
        }
    }

    // Shutting down (ShuttingDown.dc.html), or why it did not.
    if mode == 4: VerticalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: shutdown-failed ? 820px : parent.height;
        alignment: center;
        spacing: 36px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("logo.svg");
                width: 144px;
                height: 144px;
            }
        }
        Text {
            horizontal-alignment: center;
            text: shutdown-title;
            font-family: "Inter";
            font-size: 68px;
            font-weight: 700;
            color: Palette.bright;
        }
        if shutdown-failed: Text {
            horizontal-alignment: center;
            text: shutdown-subtitle;
            font-family: "Inter";
            font-size: 36px;
            color: Palette.err;
            wrap: word-wrap;
        }
        if !shutdown-failed: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 1040px;
                height: 24px;
                border-radius: 12px;
                background: Palette.track;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * Math.min(1, Math.max(0, progress));
                    border-radius: 12px;
                    background: Palette.accent;
                }
            }
        }
        if !shutdown-failed: Text {
            horizontal-alignment: center;
            text: progress-note;
            font-family: "Inter";
            font-size: 36px;
            color: Palette.dim;
        }
        if !shutdown-failed: Text {
            horizontal-alignment: center;
            text: shutdown-subtitle;
            font-family: "Inter";
            font-size: 30px;
            color: Palette.dim;
        }
    }

    if mode == 5: VerticalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        alignment: center;
        spacing: 36px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 192px;
                height: 192px;
                border-radius: 96px;
                border-width: 6px;
                border-color: Palette.ok;
                Icon {
                    d: Icons.check;
                    size: 120px;
                    weight: 2.5;
                    tint: Palette.ok;
                }
            }
        }
        Text {
            horizontal-alignment: center;
            text: "Safe to unplug";
            font-family: "Inter";
            font-size: 80px;
            font-weight: 700;
            color: Palette.ok;
        }
        Text {
            horizontal-alignment: center;
            text: "Every service stopped and its data is saved.\nThe screen may stay lit: the Nodo is off.";
            font-family: "Inter";
            font-size: 36px;
            color: Palette.dim;
        }
        Text {
            horizontal-alignment: center;
            text: "To start it again, plug it back in.";
            font-family: "Inter";
            font-size: 30px;
            color: Palette.dim;
        }
    }

    for b in buttons: Btn {
        b: b;
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (root.key(event.text, event.modifiers.shift)) {
                return accept;
            }
            reject
        }
        TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.pointer-down(self.mouse-x, self.mouse-y);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.pointer-up();
                }
            }
            moved => {
                root.pointer-move(self.mouse-x, self.mouse-y);
            }
        }
    }

    if c-open: ConsoleView {
        width: root.width;
        height: root.height;
        page: root.c-page;
        overlay: root.c-overlay;
        status: root.c-status;
        web: root.c-web;
        services: root.c-services;
        network: root.c-network;
        device: root.c-device;
        keyboard: root.c-keyboard;
        pin: root.c-pin;
        reset: root.c-reset;
        dialog: root.c-dialog;
        wifi: root.c-wifi;
        logo: root.c-logo;
        toast: root.c-toast;
        toast-error: root.c-toast-error;
        act(id) => { root.c-act(id); }
        key(k) => { root.c-key(k); }
    }

    init => {
        keys.focus();
    }
}

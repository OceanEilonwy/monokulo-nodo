#!/bin/sh
exec 2>&1
# With a console as stdin, cuprated runs its command prompt and floods the log.
exec </dev/null

# A board can keep chain data on a separate drive. Never fall back to the system disk.
data=/var/lib/cuprated
[ -r ./conf ] && . ./conf
if [ -n "${DATA_MOUNT:-}" ]; then
	if ! mountpoint -q "$DATA_MOUNT"; then
		echo "refusing to start: $DATA_MOUNT is not mounted"
		sleep 30
		exit 1
	fi
	data=$DATA_MOUNT/cuprated
	install -d -o _cuprated -g _cuprated -m 750 "$data"
fi

# A user namespace with no room for nested ones, so cuprated cannot make namespaces of its own.
# The host network is shared, and with it the abstract Unix socket namespace, so nodo-confine
# (nodo-tools) runs last: Landlock scoping against abstract sockets and signals where the kernel
# has it (Linux 6.12), and a seccomp filter that refuses Unix sockets, io_uring and foreign
# syscall ABIs. It then becomes cuprated, so the process keeps its name for control/t.
exec chpst -u _cuprated:_cuprated bwrap \
	--ro-bind /usr /usr \
	--symlink usr/bin /bin \
	--symlink usr/lib /lib \
	--symlink usr/lib /lib64 \
	--ro-bind /etc/cuprated /etc/cuprated \
	--ro-bind-try /etc/resolv.conf /etc/resolv.conf \
	--ro-bind-try /etc/ssl /etc/ssl \
	--bind "$data" /var/lib/cuprated \
	--proc /proc \
	--dev /dev \
	--tmpfs /tmp \
	--setenv HOME /var/lib/cuprated \
	--unshare-user --disable-userns \
	--unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup-try \
	--new-session --die-with-parent \
	/usr/bin/nodo-confine -- /usr/bin/cuprated --config-file /etc/cuprated/Cuprated.toml --skip-config-warning

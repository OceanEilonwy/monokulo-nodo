# Emulated aarch64 machine used for automated boot tests.
BOARD_ARCH=aarch64
BOARD_QEMU="qemu-system-aarch64 -M virt -cpu max"
BOARD_STAGE1_MODULES="virtio_blk"
BOARD_CONSOLE=ttyAMA0
BOARD_ROOT=/dev/vda1
BOARD_DRACUT_DRIVERS="virtio_blk"
BOARD_FIRMWARE_IGNORE="sof-firmware alsa-firmware linux-firmware linux-firmware-amd linux-firmware-broadcom linux-firmware-intel linux-firmware-network linux-firmware-nvidia linux-firmware-qualcomm"
BOARD_NOEXTRACT="/usr/lib/modules/*/kernel/sound/* /usr/lib/modules/*/kernel/drivers/gpu/* /usr/lib/modules/*/kernel/drivers/media/* /usr/lib/modules/*/kernel/drivers/staging/* /usr/lib/modules/*/kernel/drivers/infiniband/* /usr/lib/modules/*/kernel/drivers/isdn/*"
# Size budgets are set from the measured image. Lower them as it shrinks.
BOARD_MAX_INITRAMFS_MB=30
BOARD_MAX_KERNEL_MB=45
BOARD_MAX_ROOTFS_MB=580

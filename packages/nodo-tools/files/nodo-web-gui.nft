# The web GUI's process (nodo-web-gui, as _nodo_webgui) answers Caddy on loopback and talks to the
# helper over a Unix socket. It never opens a connection of its own, so it may send only answers.
# The rules sit in a chain of their own: a drop in any chain on the hook is final, so they hold
# whatever other fragments accept in theirs.
# Who may connect to its port is in nodo-caddy's fragment, which is where the _caddy account exists.
table inet monokulo {
	chain web_gui_output {
		type filter hook output priority filter; policy accept;
		meta skuid "_nodo_webgui" ct state established,related accept
		meta skuid "_nodo_webgui" drop
	}
}

# FriendlyElec NanoPC-T6N, booted from microSD. The eMMC and existing SSD data are left alone.
BOARD_ARCH=aarch64
# The platform: the helper, TUI, health daemon and nodo-confine (nodo-tools), and the web proxy,
# dynamic DNS and local address services. The helper enables the web services when sites ask for
# them. Monokulo is a feed app, installed through the helper, so it is not part of the image.
# No Vulkan, unlike the mainline card: this kernel's Mali driver is Arm's kbase, which Mesa's
# panvk cannot use (it needs panthor).
BOARD_PACKAGES="linux-nanopc-t6n linux-firmware-network nodo-tools nodo-caddy nodo-ddns nodo-localnet eudev alsa-utils wpa_supplicant bluez dbus v4l-utils"
# Started at boot, besides the base services: the helper the TUI talks to, the health daemon and
# the automatic update timer, which does nothing until the owner enables updates for a package.
BOARD_SERVICES="nodo-helper nodo-healthd nodo-autoupdate udevd nodo-sound"
# The vendor kernel cannot run under QEMU, so a stock kernel runs the configure step.
BOARD_STAGE_KERNEL=linux6.18
BOARD_STAGE_CONSOLE=ttyAMA0
BOARD_QEMU="qemu-system-aarch64 -M virt -cpu max"
BOARD_STAGE1_MODULES="virtio_blk"
BOARD_CONSOLE=ttyFIQ0
BOARD_ROOT=/dev/mmcblk0p8
BOARD_FSTAB_EXTRA="PARTLABEL=NODO_BLOCKCHAIN /media/monero xfs defaults,noatime,nofail 0 0"
# The vendor kernel may not load compressed firmware.
BOARD_DECOMPRESS_FIRMWARE=1
BOARD_MKDIRS="/media/monero"
BOARD_DRACUT_DRIVERS=""
BOARD_FIRMWARE_IGNORE="linux sof-firmware alsa-firmware linux-firmware linux-firmware-amd linux-firmware-broadcom linux-firmware-intel linux-firmware-nvidia linux-firmware-qualcomm"
# Firmware: only what this board's hardware asks for, from linux-firmware-network. The Realtek
# 2.5GbE port, the Mali-G610's CSF firmware (arm/mali/arch10.8 links to arch10.10) for panthor,
# and Wi-Fi and Bluetooth firmware for the M.2 and USB cards the kernel has drivers for: Realtek
# rtw88/rtw89 and their Bluetooth, MediaTek MT7921/MT7922/MT7925, Intel AX200/AX210/BE200 and
# Qualcomm WCN6855/WCN7850. For rtw89 and Intel only the firmware versions 6.18 loads are kept
# (plus the rtw89 files 6.1 names), and not the QCNCM865 variant of WCN7850. About 50 MiB, kept
# once, uncompressed (BOARD_DECOMPRESS_FIRMWARE).
BOARD_NOEXTRACT="/usr/lib/firmware/* !/usr/lib/firmware/rtl_nic/rtl8125* !/usr/lib/firmware/arm/mali/arch10.* !/usr/lib/firmware/rtw88/* !/usr/lib/firmware/rtw89/rtw8851b_fw.bin* !/usr/lib/firmware/rtw89/rtw8852a_fw.bin* !/usr/lib/firmware/rtw89/rtw8852b_fw-1.bin* !/usr/lib/firmware/rtw89/rtw8852bt_fw.bin* !/usr/lib/firmware/rtw89/rtw8852c_fw.bin* !/usr/lib/firmware/rtw89/rtw8852c_fw-2.bin* !/usr/lib/firmware/rtw89/rtw8922a_fw-4.bin* !/usr/lib/firmware/rtl_bt/* !/usr/lib/firmware/mediatek/*MT7961* !/usr/lib/firmware/mediatek/*MT7922* !/usr/lib/firmware/mediatek/mt7925/* !/usr/lib/firmware/*iwlwifi-cc-a0-77.* !/usr/lib/firmware/*iwlwifi-ty-a0-gf-a0-89.* !/usr/lib/firmware/*iwlwifi-ty-a0-gf-a0.pnvm* !/usr/lib/firmware/*iwlwifi-gl-c0-fm-c0-10[01].* !/usr/lib/firmware/*iwlwifi-gl-c0-fm-c0.pnvm* !/usr/lib/firmware/intel/ibt-20-* !/usr/lib/firmware/intel/ibt-0040-0041.* !/usr/lib/firmware/intel/ibt-0041-0041.* !/usr/lib/firmware/intel/ibt-0291-0291.* !/usr/lib/firmware/intel/ibt-0093-0041.ddc* !/usr/lib/firmware/intel/ibt-0093-0291.sfi* !/usr/lib/firmware/ath11k/WCN6855/* !/usr/lib/firmware/ath12k/WCN7850/* /usr/lib/firmware/ath12k/WCN7850/hw2.0/ncm865/* !/usr/lib/firmware/qca/hpbtfw21* !/usr/lib/firmware/qca/hpnv21* !/usr/lib/firmware/qca/hmtbtfw20* !/usr/lib/firmware/qca/hmtnv20*"
# Pinned FriendlyElec tooling that provides the bootloader for this board family.
BOARD_SDFUSE_COMMIT=430f0c0
# Size budgets, which scripts/build-image.sh enforces. The root filesystem measured 592 MiB on
# 2026-11-09, again with nodo-gpu-check and the gpu group, (486 MiB before the sound and media modules, about 52 MiB of firmware, eudev,
# ALSA, wpa_supplicant, bluez and v4l-utils); the vendor modules are left whole, since the card
# has not run on the board yet. The budget is about 10% above. The kernel budget is the kernel
# partition, 40 MiB, and holds kernel.img, 33.6 MiB. There is no initramfs to measure.
BOARD_MAX_ROOTFS_MB=650
BOARD_MAX_KERNEL_MB=40

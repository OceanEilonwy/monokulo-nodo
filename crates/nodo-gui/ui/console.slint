component PinView inherits Rectangle {
    in property <CPin> pin;
    callback key(string);
    background: C.ground;
    TouchArea { }
    HorizontalLayout {
        padding-left: 112px;
        padding-right: 112px;
        padding-top: 80px;
        padding-bottom: 80px;
        spacing: 80px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 36px;
            Image {
                source: @image-url("logo.svg");
                width: 128px;
                height: 128px;
            }
            T {
                text: "Enter the screen PIN";
                font-size: 72px;
                font-weight: 700;
                wrap: word-wrap;
            }
            T {
                text: pin.wrong ? "That's not the PIN" : pin.busy ? "Checking…" : pin.sub;
                color: pin.wrong ? C.bad : C.dim;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 32px;
                for i in 6: Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 26px;
                    background: i < pin.digits ? C.accent : transparent;
                    border-width: i < pin.digits ? 0px : 6px;
                    border-color: #5c5c5c;
                }
            }
            T {
                text: "The PIN guards changes made on this screen. It is not the device passphrase.";
                font-size: 30px;
                color: C.dim;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 24px;
            for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["cancel", "0", "back"]]: HorizontalLayout {
                spacing: 24px;
                for k in row: Rectangle {
                    width: 256px;
                    height: Touch.pin-key;
                    border-radius: 40px;
                    background: pk.pressed ? C.off : k == "cancel" || k == "back" ? C.card : C.key;
                    if k != "back": T {
                        text: k == "cancel" ? "Cancel" : k;
                        font-family: k == "cancel" ? C.ui : C.mono;
                        font-size: k == "cancel" ? 40px : 72px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        color: k == "cancel" ? C.soft : C.fg;
                    }
                    if k == "back": Icon {
                        d: Icons.delete;
                        size: 64px;
                        tint: C.soft;
                    }
                    pk := TouchArea {
                        enabled: !pin.busy;
                        clicked => {
                            root.key("pin:" + k);
                        }
                    }
                }
            }
        }
    }
}

component ResetView inherits Rectangle {
    in property <CReset> r;

                    Tx { text: "▲  Alice's apps is now signed with a different key"; font-size: 32px; font-weight: 700; color: G.accent; }
                    Tx { text: "This happens when a publisher replaces a lost key, and also when someone else takes over their address. Until you decide, the Nodo installs nothing new from Alice's apps."; color: G.dim; wrap: word-wrap; font-size: 24px; }
                    for k in [{ l: "Key you trust", v: "9f036eb1  44d27a10  c85be391  0d762aff", c: #9AA2A9 }, { l: "New key", v: "17c4902e  aa5f6388  b9d14e77  301ce542", c: #F2A33A }]: HorizontalLayout {
                        height: 64px;

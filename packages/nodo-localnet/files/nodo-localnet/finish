#!/bin/sh
# Takes the local address away whenever the service stops, so nothing keeps answering on it.
dir=/run/nodo-localnet
ip link del nodo-local 2>/dev/null
if [ -s "$dir/static" ]; then
	read -r parent address < "$dir/static"
	ip addr del "$address" dev "$parent" 2>/dev/null
	rm -f "$dir/static"
fi
if grep -q '^status=ready' "$dir/state" 2>/dev/null; then
	printf 'status=waiting\n' > "$dir/state"
	# The helper takes local sites off the address that just went away. See notify in ./run.
	[ -x /usr/bin/nodo-tui ] && /usr/bin/nodo-tui --ctl local-address-changed >/dev/null 2>&1 </dev/null &
fi
exit 0

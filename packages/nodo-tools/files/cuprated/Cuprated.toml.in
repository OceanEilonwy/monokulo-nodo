# Generated by nodo-helper from your settings. Change them in nodo-tui, not here.
# Unset values use cuprated's defaults: https://user.cuprate.org/config.html
network = "Mainnet"
fast_sync = true

[tracing.file]
level = "$(cuprated.log_level)"
max_log_files = 3

[p2p.clear_net]
enable_inbound = "$(cuprated.accept_inbound)"
listen_on = "0.0.0.0"
enable_inbound_v6 = false
outbound_connections = "$(cuprated.outbound_peers)"
max_inbound_connections = "$(cuprated.inbound_peers)"

# RPC is restricted and on loopback only, as in cuprated-service's default Cuprated.toml.
[rpc.unrestricted]
enable = false

[rpc.restricted]
address = "127.0.0.1"
port = "$(cuprated.rpc_port)"
enable = true
advertise = false

[fs]
fast_data_directory = "/var/lib/cuprated"
slow_data_directory = "/var/lib/cuprated"
cache_directory = "/var/lib/cuprated/cache"

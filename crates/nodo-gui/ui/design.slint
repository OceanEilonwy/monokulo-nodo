// ---------------------------------------------------------------- unlocking changes

component PinKey inherits Rectangle {
    in property <string> label;
    in property <bool> dark;
    width: 200px;
    height: 120px;
    border-radius: 24px;
    background: dark ? DP.surface : DP.raised;
    border-width: dark ? 1px : 0px;
    border-color: DP.line;
    T {
        text: label;
        font-size: dark ? 32px : 44px;
        font-weight: 700;
        color: dark ? DP.dim : DP.bright;
        horizontal-alignment: center;
    }
}

// state: 0 asking, 1 wrong, 2 locked out
component PinPrompt inherits Rectangle {
    in property <int> state;
    background: #000000E0;
    Rectangle {
        x: 0;
        y: 0;
        width: 1920px;
        height: 1080px;
        background: #000000D0;
    }
    Card {
        x: 360px;
        y: 90px;
        width: 1200px;
        height: 900px;
        background: DP.card;
        border-width: 1px;
        border-color: DP.line;
        VerticalLayout {
            padding: 48px;
            spacing: 20px;
            alignment: start;
            T {
                height: 60px;
                horizontal-alignment: center;
                text: state == 2 ? "Too many tries" : "Enter the screen PIN";
                font-size: 40px;
                font-weight: 700;
                color: state == 2 ? DP.err : DP.bright;
            }
            T {
                height: 44px;
                horizontal-alignment: center;
                text: state == 0 ? "to update mk-pay" : state == 1 ? "That PIN isn't right. 4 tries left." : "Try again in 4:51, or unlock from SSH.";
                color: state == 1 ? DP.err : DP.dim;
            }
            HorizontalLayout {
                height: 80px;
                alignment: center;
                spacing: 28px;
                for d[i] in [0, 1, 2, 3, 4, 5]: Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: state == 2 ? DP.card : (i < (state == 1 ? 0 : 4) ? DP.accent : DP.card);
                    border-width: 2px;
                    border-color: state == 1 ? DP.err : DP.dim;
                }
            }
            if state != 2: HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    spacing: 18px;
                    for r in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]: HorizontalLayout {
                        spacing: 18px;
                        for k in r: PinKey {
                            label: k;
                        }
                    }
                    HorizontalLayout {
                        spacing: 18px;
                        PinKey {
                            label: "Cancel";
                            dark: true;
                        }
                        PinKey {
                            label: "0";
                        }
                        PinKey {
                            label: "⌫";
                            dark: true;
                        }
                    }
                }
            }
            if state == 2: VerticalLayout {
                padding-top: 60px;
                spacing: 40px;
                T {
                    horizontal-alignment: center;
                    text: "Looking around still works; only changes wait.";
                    color: DP.dim;
                }
                HorizontalLayout {
                    alignment: center;
                    Btn {
                        label: "OK";
                        kind: 1;
                        w: 220px;
                    }
                }
            }
        }
    }
}

component NoPin inherits Rectangle {
    Bar {
        tab: 3;
        lock: 2;
    }
    VerticalLayout {
        x: 48px;
        y: 160px;
        width: 1824px;
        spacing: 24px;
        Crumbs {
            trail: ["System", "Screen", "Screen PIN"];
        }
        Card {
            height: 560px;
            VerticalLayout {
                padding: 48px;
                spacing: 22px;
                T {
                    text: "Changes from this screen are off";
                    font-size: 36px;
                    font-weight: 700;
                    color: DP.bright;
                }
                T {
                    text: "Anyone near the Nodo can touch its screen, so it can show you everything but change nothing until you choose a screen PIN.";
                    color: DP.fg;
                    wrap: word-wrap;
                }
                T {
                    text: "Choose one from a computer: ssh into the Nodo, then System › Screen › Screen PIN. You'll need the device passphrase.";
                    color: DP.dim;
                    wrap: word-wrap;
                }
                T {
                    text: "After 5 wrong tries the screen waits 5 minutes, then longer. Changes lock again 5 minutes after the last touch.";
                    color: DP.dim;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component DesignBoard inherits Window {
    width: 1920px;
    height: 1080px;
    background: DP.ground;
    default-font-family: "JetBrains Mono";
    in property <string> scene;

    if scene == "wp-logo": WallpaperLogo { with-panels: false; }
    if scene == "wp-logo-panels": WallpaperLogo { with-panels: true; }
    if scene == "m-screen": ScreenSettings { }
    if scene == "m-home": Home { }
    if scene == "m-apps": Apps { }
    if scene == "m-app": AppPage { }
    if scene == "m-settings": Settings { keyboard: false; }
    if scene == "m-settings-kbd": Settings { keyboard: true; }
    if scene == "m-get-apps": GetApps { }
    if scene == "m-install": InstallReview { }
    if scene == "m-web": WebSites { }
    if scene == "m-hosting": Hosting { }
    if scene == "m-sources": Sources { }
    if scene == "m-add-source": AddSource { }
    if scene == "m-system": System { }
    if scene == "m-updates": Updates { }
    if scene == "m-network": Network { }
    if scene == "m-backups": Backups { }
    if scene == "m-blocked": Blocked { }
    if scene == "u-pin" || scene == "u-pin-wrong" || scene == "u-lockout": Rectangle {
        AppPage { }
        PinPrompt {
            state: scene == "u-pin" ? 0 : scene == "u-pin-wrong" ? 1 : 2;
        }
    }
    if scene == "u-no-pin": NoPin { }
}

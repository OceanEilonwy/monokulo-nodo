#!/bin/sh
# Adapts what the appliance provides to what Monokulo reads, then becomes Monokulo.
#
# - The device passes package settings as NODO_<NAME> environment variables, and Monokulo reads
#   its key from MONOKULO_ENCRYPTION_KEY. Secrets stay in the environment, never in argv.
# - The daemon setting is a URL, and Monokulo wants its node as JSON with host, port and ssl.
# - Monokulo's files go in its data directory, which the sandbox mounts as $HOME.
#
# This script keeps the name of the binary it starts, so the supervisor's `pkill -x monokulo`
# matches whichever of the two is running.
set -eu

die() {
	echo "monokulo launcher: $*" >&2
	exit 1
}

if [ -z "${MONOKULO_ENCRYPTION_KEY:-}" ]; then
	[ -n "${NODO_ENCRYPTION_KEY:-}" ] || die "the encryption_key setting has no value"
	MONOKULO_ENCRYPTION_KEY=$NODO_ENCRYPTION_KEY
fi
export MONOKULO_ENCRYPTION_KEY
unset NODO_ENCRYPTION_KEY

[ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "HOME is not the data directory"

node_json() {
	url=$1
	case $url in
	http://*) ssl=false rest=${url#http://} ;;
	https://*) ssl=true rest=${url#https://} ;;
	*) die "the daemon URL must use http or https: $url" ;;
	esac
	authority=${rest%%/*}
	path=${rest#"$authority"}
	case $path in
	"" | /) ;;
	*) die "Monokulo reaches a node at its root, so the daemon URL cannot have a path: $url" ;;
	esac
	case $authority in
	\[*\]:*) host=${authority%:*} port=${authority##*:} ;;
	\[*\]) host=$authority port= ;;
	*:*) host=${authority%%:*} port=${authority#*:} ;;
	*) host=$authority port= ;;
	esac
	if [ -z "$port" ]; then
		if [ "$ssl" = true ]; then port=443; else port=80; fi
	fi
	# The appliance has already checked the URL. These checks keep the JSON below well formed
	# even if this script is ever given something else.
	case $host in
	"" | *[!A-Za-z0-9.:\[\]-]*) die "unexpected daemon host: $host" ;;
	esac
	case $port in
	"" | *[!0-9]*) die "unexpected daemon port: $port" ;;
	esac
	printf '{"host":"%s","port":%s,"ssl":%s}' "$host" "$port" "$ssl"
}

daemon=
for arg do
	shift
	case $arg in
	--daemon-url=*) daemon=$(node_json "${arg#--daemon-url=}") || exit 1 ;;
	*) set -- "$@" "$arg" ;;
	esac
done
[ -n "$daemon" ] || die "no --daemon-url was given"

exec "$(dirname "$0")/../libexec/monokulo" \
	--options "$HOME/monokulo.toml" \
	--database-path "$HOME/monokulo.db" \
	--engine-database-path "$HOME/engine.db" \
	--engine-monero-node-mainnet "$daemon" \
	"$@"

# Template file for 'linux-nanopc-t6n'
# FriendlyElec's kernel, because mainline has no device tree for this board.
pkgname=linux-nanopc-t6n
version=6.1.141
revision=1
_commit=30d3e1c2470a7282f37b96fdd4354314dda69aa3
archs="aarch64"
hostmakedepends="bc bison flex kmod openssl-devel perl python3 elfutils-devel cpio tar xz lz4 make gcc"
makedepends="openssl-devel"
depends="kmod"
short_desc="Linux kernel for the FriendlyElec NanoPC-T6N"
maintainer="monokulo-nodo <noreply@localhost>"
license="GPL-2.0-only"
homepage="https://github.com/friendlyarm/kernel-rockchip/tree/nanopi6-v6.1.y"
distfiles="https://github.com/friendlyarm/kernel-rockchip/archive/${_commit}.tar.gz"
checksum=bcb6213595c5c6d701105f63b1a4a0da8cb921f05ea382591f2ca6fbe65b9654
nostrip=yes
noverifyrdeps=yes
preserve=yes
nopie=yes

_kmake() {
	make ARCH=arm64 CROSS_COMPILE="${XBPS_CROSS_TRIPLET:-aarch64-linux-gnu}-" \
		HOSTCC=gcc HOSTCXX=g++ HOSTCFLAGS= HOSTLDFLAGS= HOSTPKG_CONFIG=pkg-config \
		KCFLAGS="-Wno-error" WERROR=0 "$@"
}

do_configure() {
	unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
	_kmake nanopi6_linux_defconfig
	# Everything monokulo-nodo relies on must be present whatever the vendor default is.
	scripts/config --enable USER_NS --enable PID_NS --enable NET_NS --enable IPC_NS \
		--enable UTS_NS --enable SECCOMP_FILTER --enable R8169 --enable BLK_DEV_NVME \
		--enable EXT4_FS --module XFS_FS --module NF_TABLES --module NF_TABLES_INET \
		--enable NF_TABLES_IPV4 --enable NF_TABLES_IPV6 --module NFT_CT \
		--module NF_CONNTRACK --module DM_CRYPT --enable SYSVIPC \
		--disable WERROR --disable DEBUG_INFO --disable DEBUG_INFO_BTF
	_kmake olddefconfig
}

do_build() {
	unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
	_kmake -j"${makejobs#-j}" nanopi6-images modules
}

do_install() {
	unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
	_kmake INSTALL_MOD_PATH="${DESTDIR}/usr" INSTALL_MOD_STRIP=1 modules_install
	rm -f "${DESTDIR}"/usr/lib/modules/*/build "${DESTDIR}"/usr/lib/modules/*/source
	vinstall kernel.img 644 usr/share/monokulo/boot
	vinstall resource.img 644 usr/share/monokulo/boot
	vinstall .config 644 usr/share/monokulo/boot kernel.config
}

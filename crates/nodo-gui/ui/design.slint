// Design boards for the touch screen's management and wallpapers (mock data, no helper).
//
// `nodo-gui --screenshot <scene> <file.png>` renders one of these at 1920 x 1080 with the real
// Slint software renderer, so the canvas shows exactly what the panel would. The screens mirror
// the simplified TUI (Home, Apps, Web, System) laid out for fingers: every target is at least
// 88 px, one primary action per screen, buttons inside the card they act on.

global DP {
    out property <color> ground: #000000;
    out property <color> surface: #0B0D0F;
    out property <color> card: #14181B;
    out property <color> raised: #1E2327;
    out property <color> hover: #262C31;
    out property <color> field: #07090A;
    out property <color> line: #2A2F33;
    out property <color> fg: #D7DADC;
    out property <color> bright: #F4F5F6;
    out property <color> dim: #8A9298;
    out property <color> faint: #5C646A;
    out property <color> accent: #F2A33A;
    out property <color> on-accent: #121416;
    out property <color> ok: #6FD6B3;
    out property <color> err: #FF8A7A;
    out property <color> err-fill: #3A1D1A;
    out property <color> info: #86BEFF;
}

// ---------------------------------------------------------------- building blocks

component T inherits Text {
    color: DP.fg;
    font-size: 28px;
    vertical-alignment: center;
}


// A small padlock drawn with rectangles (the screen's font has no emoji).
component LockIcon inherits Rectangle {
    in property <color> tint;
    in property <bool> open: false;
    width: 26px;
    height: 30px;
    Rectangle {
        x: open ? 9px : 4px;
        y: 0;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: 4px;
        border-color: tint;
    }
    Rectangle {
        x: 0;
        y: 12px;
        width: 26px;
        height: 18px;
        border-radius: 4px;
        background: tint;
    }
}

// kind: 0 primary (orange), 1 secondary (grey), 2 destructive (red tint), 3 quiet (text only)
component Btn inherits Rectangle {
    in property <string> label;
    in property <int> kind: 0;
    in property <length> w: 280px;
    in property <bool> locked: false;
    width: w;
    height: 88px;
    border-radius: 44px;
    background: kind == 0 ? DP.accent : kind == 1 ? DP.raised : kind == 2 ? DP.err-fill : transparent;
    border-width: kind == 2 ? 2px : 0px;
    border-color: DP.err;
    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        if locked: VerticalLayout {
            alignment: center;
            LockIcon {
                tint: kind == 0 ? DP.on-accent : DP.dim;
            }
        }
        Text {
            text: label;
            font-size: 30px;
            font-weight: 700;
            vertical-alignment: center;
            color: kind == 0 ? DP.on-accent : kind == 2 ? DP.err : kind == 3 ? DP.accent : DP.bright;
        }
    }
}

component Card inherits Rectangle {
    background: DP.card;
    border-radius: 28px;
}

// A tappable row: name, detail, value on the right and a chevron. 112 px tall.
component Row inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> value;
    in property <color> value-color: DP.dim;
    in property <bool> chevron: true;
    in property <bool> hovered: false;
    in property <bool> last: false;
    in property <length> name-width: 300px;
    height: 112px;
    background: hovered ? DP.hover : transparent;
    border-radius: 20px;
    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 28px;
        T {
            text: name;
            font-weight: 700;
            color: DP.bright;
            width: name-width;
        }
        T {
            text: detail;
            color: DP.dim;
            horizontal-stretch: 1;
            overflow: elide;
        }
        T {
            text: value;
            color: value-color;
        }
        if chevron: T {
            text: "›";
            font-size: 44px;
            color: DP.faint;
        }
    }
    if !last: Rectangle {
        x: 32px;
        y: parent.height - 1px;
        width: parent.width - 64px;
        height: 1px;
        background: DP.line;
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    width: 112px;
    height: 60px;
    border-radius: 30px;
    background: on ? DP.accent : DP.raised;
    Rectangle {
        x: on ? parent.width - 54px : 6px;
        y: 6px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: on ? DP.on-accent : DP.dim;
    }
}

component Field inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> help;
    in property <bool> focused: false;
    in property <bool> error: false;
    in property <string> suffix;
    height: help != "" ? 150px : 112px;
    HorizontalLayout {
        y: 0;
        height: 112px;
        spacing: 28px;
        T {
            text: label;
            color: DP.dim;
            width: 300px;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 88px;
            border-radius: 18px;
            background: DP.field;
            border-width: focused || error ? 3px : 1px;
            border-color: error ? DP.err : focused ? DP.accent : DP.line;
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                T {
                    text: value;
                    color: DP.bright;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if focused: Rectangle {
                    width: 3px;
                    height: 44px;
                    background: DP.accent;
                }
                if suffix != "": T {
                    text: suffix;
                    color: DP.dim;
                }
            }
        }
    }
    if help != "": T {
        x: 328px;
        y: 112px;
        height: 38px;
        text: help;
        font-size: 24px;
        color: error ? DP.err : DP.dim;
    }
}

component Key inherits Rectangle {
    in property <string> label;
    in property <length> kw: 150px;
    in property <bool> dark: false;
    width: kw;
    height: 92px;
    border-radius: 16px;
    background: dark ? DP.card : DP.raised;
    T {
        text: label;
        font-size: 32px;
        color: DP.bright;
        horizontal-alignment: center;
    }
}

// An on-screen keyboard: the bottom 440 px of the screen.
component Keyboard inherits Rectangle {
    background: DP.surface;
    height: 440px;
    width: 1920px;
    Rectangle {
        y: 0;
        height: 1px;
        background: DP.line;
    }
    VerticalLayout {
        padding: 22px;
        spacing: 14px;
        alignment: center;
        HorizontalLayout {
            spacing: 14px;
            alignment: center;
            for k in ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"]: Key {
                label: k;
            }
            Key {
                label: "⌫";
                kw: 190px;
                dark: true;
            }
        }
        HorizontalLayout {
            spacing: 14px;
            alignment: center;
            for k in ["a", "s", "d", "f", "g", "h", "j", "k", "l"]: Key {
                label: k;
            }
            Key {
                label: "Done";
                kw: 260px;
                dark: true;
            }
        }
        HorizontalLayout {
            spacing: 14px;
            alignment: center;
            Key {
                label: "⇧";
                kw: 190px;
                dark: true;
            }
            for k in ["z", "x", "c", "v", "b", "n", "m", ".", "/"]: Key {
                label: k;
            }
            Key {
                label: "-";
                kw: 120px;
            }
        }
        HorizontalLayout {
            spacing: 14px;
            alignment: center;
            Key {
                label: "123";
                kw: 190px;
                dark: true;
            }
            Key {
                label: ":";
                kw: 120px;
            }
            Key {
                label: "space";
                kw: 820px;
            }
            Key {
                label: "Paste";
                kw: 220px;
                dark: true;
            }
            Key {
                label: "← →";
                kw: 190px;
                dark: true;
            }
        }
    }
}

// The management screens' top bar: back to the wallpaper, the four tabs, the lock state.
// lock: 0 changes locked, 1 unlocked (counts down), 2 no screen PIN set.
component Bar inherits Rectangle {
    in property <int> tab: 0;
    in property <int> lock: 0;
    in property <string> apps-count: "2";
    x: 0;
    y: 0;
    width: 1920px;
    height: 136px;
    background: DP.surface;
    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 24px;
        padding-bottom: 24px;
        spacing: 16px;
        Rectangle {
            width: 220px;
            border-radius: 44px;
            background: DP.raised;
            T {
                horizontal-alignment: center;
                text: "‹  Screen";
                font-weight: 700;
                color: DP.bright;
            }
        }
        Rectangle {
            width: 36px;
        }
        for name[i] in ["Home", "Apps", "Web", "System"]: Rectangle {
            width: 220px;
            border-radius: 44px;
            background: i == tab ? DP.accent : transparent;
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                T {
                    text: name;
                    font-size: 32px;
                    font-weight: 700;
                    color: i == tab ? DP.on-accent : DP.fg;
                }
                if i == 1 && apps-count != "": T {
                    text: apps-count;
                    font-size: 28px;
                    color: i == tab ? DP.on-accent : DP.accent;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Rectangle {
            width: lock == 1 ? 420px : 360px;
            border-radius: 44px;
            background: lock == 1 ? #1D2A24 : DP.raised;
            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    LockIcon {
                        tint: lock == 1 ? DP.ok : DP.dim;
                        open: lock == 1;
                    }
                }
                T {
                    text: lock == 0 ? "Changes locked" : lock == 1 ? "Unlocked · 4:12" : "No screen PIN";
                    font-weight: 700;
                    color: lock == 1 ? DP.ok : DP.dim;
                }
            }
        }
        Rectangle {
            width: 88px;
            border-radius: 44px;
            background: DP.raised;
            border-width: 2px;
            border-color: #7A3A33;
            T {
                text: "⏻";
                font-size: 36px;
                color: DP.err;
                horizontal-alignment: center;
            }
        }
    }
}

// A crumb line ("Apps › mk-pay") with page actions on the right.
component Crumbs inherits HorizontalLayout {
    in property <[string]> trail;
    height: 96px;
    spacing: 16px;
    for c[i] in trail: HorizontalLayout {
        spacing: 16px;
        if i > 0: T {
            text: "›";
            color: DP.faint;
            font-size: 34px;
        }
        T {
            text: c;
            font-size: 32px;
            font-weight: i == trail.length - 1 ? 700 : 400;
            color: i == trail.length - 1 ? DP.bright : DP.dim;
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    @children
}

component Caption inherits Text {
    x: 48px;
    y: 1044px;
    height: 30px;
    font-size: 20px;
    color: DP.faint;
}

// The Nodo logo, drawn from tools/splash/logo.svg.
component Logo inherits Image {
    source: @image-url("logo.svg");
    image-fit: contain;
}

// ---------------------------------------------------------------- the screens

component WallpaperLogo inherits Rectangle {
    in property <bool> with-panels;
    background: DP.ground;
    // Top bar as on the panels wallpaper: name and time left, Manage and Shut down right.
    HorizontalLayout {
        x: 36px;
        y: 24px;
        width: 1848px;
        height: 88px;
        spacing: 20px;
        T {
            text: "monokulo-nodo";
            font-size: 26px;
            font-weight: 700;
        }
        T {
            text: "thu 13 nov  14:32";
            font-size: 26px;
            color: DP.dim;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 236px;
            border-radius: 20px;
            border-width: 2px;
            border-color: #3A4045;
            T {
                horizontal-alignment: center;
                text: "☰  Manage";
                font-size: 26px;
                font-weight: 700;
                color: DP.fg;
            }
        }
        Rectangle {
            width: 236px;
            border-radius: 20px;
            border-width: 2px;
            border-color: #7A3A33;
            T {
                horizontal-alignment: center;
                text: "⏻  Shut down";
                font-size: 26px;
                font-weight: 700;
                color: DP.err;
            }
        }
    }
    if !with-panels: Rectangle {
        Logo {
            x: (1920px - 560px) / 2;
            y: 230px;
            width: 560px;
            height: 560px;
        }
        T {
            x: 0;
            y: 830px;
            width: 1920px;
            height: 60px;
            horizontal-alignment: center;
            text: "n o d o";
            font-size: 44px;
            font-weight: 700;
            color: #FF6600;
        }
        T {
            x: 0;
            y: 900px;
            width: 1920px;
            height: 44px;
            horizontal-alignment: center;
            text: "All 4 apps running  ·  node 63% synced  ·  48 °C";
            font-size: 26px;
            color: DP.dim;
        }
    }
    if with-panels: Rectangle {
        Logo {
            x: 120px;
            y: 220px;
            width: 640px;
            height: 640px;
        }
        T {
            x: 120px;
            y: 880px;
            width: 640px;
            height: 60px;
            horizontal-alignment: center;
            text: "n o d o";
            font-size: 44px;
            font-weight: 700;
            color: #FF6600;
        }
        // Two panels in the tiles' style on the right.
        for p[i] in [
            { title: "MONERO NODE", big: "63%", unit: "synced", note: "height 2,190,400 · about 7 h left", c: #F2A33A },
            { title: "PAYMENTS TODAY", big: "4.82", unit: "XMR", note: "37 paid · 2 waiting", c: #6FD6B3 },
            { title: "DEVICE", big: "48", unit: "°C", note: "ssd 27% · up 3 days", c: #6FD6B3 }
        ]: Rectangle {
            x: 900px;
            y: 180px + i * 280px;
            width: 900px;
            height: 248px;
            border-radius: 20px;
            border-width: 2px;
            border-color: #3A4045;
            T {
                x: 36px;
                y: 24px;
                height: 40px;
                text: p.title;
                font-size: 22px;
                font-weight: 700;
                letter-spacing: 1.3px;
                color: DP.dim;
            }
            HorizontalLayout {
                x: 36px;
                y: 72px;
                height: 100px;
                spacing: 16px;
                alignment: start;
                T {
                    text: p.big;
                    font-size: 84px;
                    font-weight: 700;
                    color: p.c;
                }
                T {
                    text: p.unit;
                    font-size: 30px;
                    color: DP.dim;
                    vertical-alignment: bottom;
                }
            }
            T {
                x: 36px;
                y: 186px;
                height: 40px;
                text: p.note;
                font-size: 24px;
                color: DP.dim;
            }
        }
    }
}

// System › Screen: which wallpaper, and when management goes back to it.
component ScreenSettings inherits Rectangle {
    Bar {
        tab: 3;
        lock: 1;
    }
    VerticalLayout {
        x: 48px;
        y: 160px;
        width: 1824px;
        spacing: 24px;
        Crumbs {
            trail: ["System", "Screen"];
        }
        Card {
            height: 480px;
            VerticalLayout {
                padding: 36px;
                spacing: 24px;
                T {
                    text: "Wallpaper";
                    font-size: 34px;
                    font-weight: 700;
                    color: DP.bright;
                }
                T {
                    text: "What the screen shows when nobody is using it.";
                    color: DP.dim;
                }
                HorizontalLayout {
                    spacing: 28px;
                    for o[i] in [
                        { name: "Panels", sub: "Your apps' tiles" },
                        { name: "Logo", sub: "The Nodo, and one status line" },
                        { name: "Logo and panels", sub: "The logo beside three tiles" }
                    ]: Rectangle {
                        height: 260px;
                        horizontal-stretch: 1;
                        border-radius: 24px;
                        background: i == 1 ? DP.raised : DP.surface;
                        border-width: i == 1 ? 3px : 1px;
                        border-color: i == 1 ? DP.accent : DP.line;
                        // A small preview of each.
                        if i == 0: Rectangle {
                            x: 28px;
                            y: 28px;
                            width: 220px;
                            height: 124px;
                            for c[j] in [0, 1, 2, 3]: Rectangle {
                                x: Math.mod(j, 2) * 112px;
                                y: Math.floor(j / 2) * 64px;
                                width: 104px;
                                height: 56px;
                                border-radius: 8px;
                                border-width: 2px;
                                border-color: #3A4045;
                            }
                        }
                        if i == 1: Logo {
                            x: 28px;
                            y: 20px;
                            width: 140px;
                            height: 140px;
                        }
                        if i == 2: Rectangle {
                            x: 28px;
                            y: 20px;
                            width: 260px;
                            height: 140px;
                            Logo {
                                x: 0;
                                y: 10px;
                                width: 120px;
                                height: 120px;
                            }
                            for j in [0, 1, 2]: Rectangle {
                                x: 136px;
                                y: 8px + j * 44px;
                                width: 120px;
                                height: 36px;
                                border-radius: 8px;
                                border-width: 2px;
                                border-color: #3A4045;
                            }
                        }
                        T {
                            x: 28px;
                            y: 172px;
                            height: 40px;
                            text: (i == 1 ? "●  " : "○  ") + o.name;
                            font-weight: 700;
                            color: i == 1 ? DP.accent : DP.bright;
                        }
                        T {
                            x: 28px;
                            y: 212px;
                            height: 32px;
                            text: o.sub;
                            font-size: 22px;
                            color: DP.dim;
                        }
                    }
                }
            }
        }
        Card {
            height: 260px;
            VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 12px;
                Row {
                    name: "Back to it";
                    detail: "after 2 minutes without a touch";
                    value: "2 min";
                }
                Row {
                    name: "Dim";
                    detail: "the wallpaper to 20% after 2 minutes";
                    chevron: false;
                    last: true;
                    HorizontalLayout {
                        alignment: end;
                        padding-right: 32px;
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: true;
                            }
                        }
                    }
                }
            }
        }
    }
}

component Home inherits Rectangle {
    Bar {
        tab: 0;
        lock: 0;
    }
    VerticalLayout {
        x: 48px;
        y: 160px;
        width: 1824px;
        spacing: 28px;
        T {
            height: 80px;
            text: "Good afternoon";
            font-size: 40px;
            font-weight: 700;
            color: DP.bright;
        }
        Card {
            height: 220px;
            HorizontalLayout {
                padding: 40px;
                spacing: 32px;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    T {
                        text: "2 app updates are ready";
                        font-size: 34px;
                        font-weight: 700;
                        color: DP.bright;
                    }
                    T {
                        text: "mk-pay and kringle. Each keeps its settings and can be undone.";
                        color: DP.dim;
                    }

# Emulated aarch64 machine running the NanoPC-T6N mainline kernel package, for boot tests of that
# kernel. The packages are the T6N set (with the device manager, sound, radio and GPU
# userspace) plus what QEMU and the kernel checks need: dracut for an initramfs, and cryptsetup
# and xfsprogs for the LUKS2 and XFS check. The modules are all kept, so the kernel checks can
# show the T6N's hardware drivers are installed. It has no
# /media/monero drive, so the T6N overlay that makes cuprated wait for one is left out.
BOARD_ARCH=aarch64
BOARD_QEMU="qemu-system-aarch64 -M virt -cpu max"
BOARD_STAGE1_MODULES="virtio_blk"
BOARD_CONSOLE=ttyAMA0
BOARD_ROOT=/dev/vda1
BOARD_DRACUT_DRIVERS="virtio_blk"
BOARD_PACKAGES="linux-mainline-rk3588 linux-firmware-network nodo-tools nodo-caddy nodo-ddns nodo-localnet eudev alsa-utils wpa_supplicant bluez dbus v4l-utils dracut zstd cryptsetup xfsprogs"
BOARD_SERVICES="nodo-helper nodo-healthd nodo-autoupdate"
BOARD_FIRMWARE_IGNORE="linux sof-firmware alsa-firmware linux-firmware linux-firmware-amd linux-firmware-broadcom linux-firmware-intel linux-firmware-nvidia linux-firmware-qualcomm"
BOARD_NOEXTRACT="/usr/lib/firmware/* !/usr/lib/firmware/rtl_nic/rtl8125*"
BOARD_QEMU_EXTRA="-device qemu-xhci,id=xhci"
# Runs tests/kernel-checks.sh after the usual checks: Landlock scoping, LUKS2 and XFS.
BOARD_KERNEL_CHECKS=1
# The root filesystem measured 485 MiB on 2026-11-09, with the T6N hardware userspace and every
# module; the budget is about 10% above.
BOARD_MAX_INITRAMFS_MB=30
BOARD_MAX_KERNEL_MB=45
BOARD_MAX_ROOTFS_MB=535

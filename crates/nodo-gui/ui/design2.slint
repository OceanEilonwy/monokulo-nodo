                                alignment: center;
                                Rectangle {
                                    width: 120px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: G.info-fill;
                                    Tx { text: s.tag; font-size: 20px; font-weight: 600; color: G.info; horizontal-alignment: center; }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            Tx { text: s.addr; font-family: G.mono; font-size: 22px; color: G.dim; }
                            Tx { text: "· " + s.n; font-size: 22px; color: G.dim; }
                        }
                        if s.problem != "": HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            Tx { text: "✕  " + s.problem; font-size: 22px; color: G.err; }
                            Tx { text: "Try again"; font-size: 22px; font-weight: 600; color: G.accent; }
                        }
                    }
                    VerticalLayout { alignment: center; GSwitch { on: s.on; } }
                    VerticalLayout { alignment: center; GButton { label: "Remove"; kind: 1; w: 190px; lock: true; } }
                }
            }
        }
    }

                    }
                    GInput { label: "To trust the new key, ask Alice by a way you trust, then type the source's name"; value: ""; placeholder: "Alice's apps"; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: end;
                        GButton { label: "Trust the new key"; kind: 1; w: 320px; state: 3; }

#!/bin/sh
# Package panels on the built-in screen (docs/SCREEN.md). On boards with a screen this service
# owns tty1 in place of its login prompt. It starts as root only to prepare the console, then runs
# nodo-screen as _nodo_screen, which may read the touchscreen (input) and nothing else.
exec 2>&1
exec </dev/null
install -d -m 0750 -o _nodo_screen -g _nodo_screen /var/lib/nodo-screen
# Kernel messages would draw over the panels: only emergencies reach the console. They still go to
# the kernel log and the serial port.
dmesg -n 1
# Terminus 16x32 with the glyphs the screen draws (rounded and dashed corners, blocks, its button
# icons) added; make-font.py builds it when the package is built. The kernel's built-in Terminus
# has the same size but none of those glyphs.
setfont -C /dev/tty1 /usr/share/nodo/nodo-screen-16x32.psf.gz ||
	setfont -C /dev/tty1 /usr/share/kbd/consolefonts/ter-v32n.psf.gz ||
	echo "nodo-screen: no console font"
# The program dims the panel's backlight when nobody uses it (docs/SCREEN.md): give its account
# that one file, and nothing else in sysfs.
for b in /sys/class/backlight/*/brightness; do
	[ -e "$b" ] || break
	chgrp _nodo_screen "$b" && chmod g+w "$b"
	break
done
# stdin and stdout become the screen; stderr stays this service's log.
exec </dev/tty1 >/dev/tty1
export TERM=linux
exec chpst -u _nodo_screen:_nodo_screen:input /usr/bin/nodo-screen

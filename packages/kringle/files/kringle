#!/bin/sh
# Puts Kringle's data file in the data directory, which the sandbox mounts as $HOME, passes the
# optional public address, and becomes Kringle. A manifest's arguments cannot name the data
# directory, and an optional setting with no value is simply absent from the environment.
#
# Email stays off: the package asks for no internet access, so no KRINGLE_MAIL* variable is set.
#
# This script keeps the name of the binary it starts, so `pkill -x kringle` matches whichever of
# the two is running.
set -eu
[ -n "${HOME:-}" ] && [ -d "$HOME" ] || {
	echo "kringle launcher: HOME is not the data directory" >&2
	exit 1
}
if [ -n "${NODO_PUBLIC_URL:-}" ]; then
	set -- "$@" --public-url "$NODO_PUBLIC_URL"
fi
for name in $(env | sed -n 's/^\(NODO_[A-Z0-9_]*\)=.*/\1/p') $(env | sed -n 's/^\(KRINGLE_[A-Z0-9_]*\)=.*/\1/p'); do
	unset "$name"
done
exec "$(dirname "$0")/../libexec/kringle" --data "$HOME/kringle.json" "$@"

# Emulated aarch64 machine used for automated boot tests.
BOARD_ARCH=aarch64
BOARD_QEMU="qemu-system-aarch64 -M virt -cpu max"
BOARD_STAGE1_MODULES="virtio_blk"
BOARD_CONSOLE=ttyAMA0
BOARD_ROOT=/dev/vda1
BOARD_DRACUT_DRIVERS="virtio_blk"
BOARD_FIRMWARE_IGNORE="sof-firmware alsa-firmware linux-firmware linux-firmware-amd linux-firmware-broadcom linux-firmware-intel linux-firmware-network linux-firmware-nvidia linux-firmware-qualcomm"
# The machine's network card is virtio-net, so radio, CAN, Bluetooth, sensor and physical
# Ethernet drivers are left out with the sound, GPU and media ones.
BOARD_NOEXTRACT="/usr/lib/modules/*/kernel/sound/* /usr/lib/modules/*/kernel/drivers/gpu/* /usr/lib/modules/*/kernel/drivers/media/* /usr/lib/modules/*/kernel/drivers/staging/* /usr/lib/modules/*/kernel/drivers/infiniband/* /usr/lib/modules/*/kernel/drivers/isdn/* /usr/lib/modules/*/kernel/drivers/net/wireless/* /usr/lib/modules/*/kernel/drivers/net/ethernet/* /usr/lib/modules/*/kernel/drivers/net/can/* /usr/lib/modules/*/kernel/net/can/* /usr/lib/modules/*/kernel/drivers/bluetooth/* /usr/lib/modules/*/kernel/net/bluetooth/* /usr/lib/modules/*/kernel/net/wireless/* /usr/lib/modules/*/kernel/net/mac80211/* /usr/lib/modules/*/kernel/drivers/iio/*"
# Size budgets are set from the measured image. Lower them as it shrinks. The root filesystem
# measured 547 MiB on 2026-11-09 (563 before the same module trimming as x86-kvm). The kernel is Void's
# stock uncompressed arm64 Image, 40 MiB, which nothing here can trim, so its budget stays.
BOARD_MAX_INITRAMFS_MB=30
BOARD_MAX_KERNEL_MB=45
BOARD_MAX_ROOTFS_MB=600

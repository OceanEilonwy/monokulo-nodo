# Template file for 'nodo-tools'
# Built from this repository's workspace, which the build container mounts at /src. The recipe hash
# in scripts/lib.sh also covers the paths named on the monokulo-sources line, so source edits rebuild.
# monokulo-sources: Cargo.toml Cargo.lock LICENSE crates
pkgname=nodo-tools
version=0.1.0
revision=22
archs="aarch64 x86_64"
build_style=cargo
configure_args="-p nodo-helper -p nodo-tui -p nodo-health -p nodo-confine -p nodo-update -p nodo-gpu-check -p nodo-screen -p nodo-gui -p nodo-power -p nodo-screen-font -p nodo-splash"
# terminus-font is what nodo-screen-font builds the screen's console font from.
hostmakedepends="pkg-config terminus-font"
# The feed gate reads zstd packages, and Void builds zstd-sys against the system library. nodo-gui
# reads the touchscreen through libinput (with udev and xkbcommon) and finds fonts with fontconfig.
makedepends="libzstd-devel libinput-devel libxkbcommon-devel eudev-libudev-devel fontconfig-devel"
depends="bubblewrap nftables cryptsetup e2fsprogs xfsprogs util-linux shadow"
short_desc="Root helper service and terminal interface for monokulo-nodo"
maintainer="monokulo-nodo <noreply@localhost>"
license="GPL-3.0-or-later"
homepage="https://github.com/OceanEilonwy/monokulo-nodo"
# The system update server (docs/UPDATES.md): the owner may point it elsewhere.
conf_files="/etc/nodo/system-update.toml"
# nodo-gui's typeface; fontconfig needs at least one font to start, and the device has no others.
font_dirs="/usr/share/fonts/nodo"
# Package settings code runs as this account, never as root. xbps turns the name into a
# shell variable, so it cannot contain a dash.
system_accounts="_nodo_settings _nodo_screen"
_nodo_settings_homedir="/var/empty"
# The screen's panels (docs/SCREEN.md) run as this account. Its only extra groups are input, for the
# touchscreen, and video, for nodo-gui to draw on the display; nodo-screen's run script hands it tty1.
_nodo_screen_homedir="/var/lib/nodo-screen"
_nodo_screen_groups="input,video"
# Members of nodo may use the helper (root always may). gpu may open the GPU's render nodes (a
# udev rule on the T6N boards gives them to it). No account is a member: a service runs with it,
# through chpst in its generated run script, only when the owner approved the GPU for it.
system_groups="nodo gpu"
make_dirs="/var/lib/nodo 0755 root root
 /var/log/nodo-helper 0750 root root
 /var/log/nodo-healthd 0750 root root
 /var/log/nodo-autoupdate 0750 root root
 /var/log/nodo-systemupdate 0750 root root
 /var/log/nodo-wifi 0750 root root
 /var/log/nodo-screen 0750 root root
 /var/log/nodo-gui 0750 root root
 /var/log/nodo-power 0750 root root
 /var/lib/nodo/wifi 0700 root root
 /etc/nodo 0755 root root"

do_extract() {
	mkdir -p "${wrksrc}"
	cp -r /src/Cargo.toml /src/Cargo.lock /src/LICENSE /src/crates "${wrksrc}/"
}

do_install() {
	vbin target/${RUST_TARGET}/release/nodo-helper
	vbin target/${RUST_TARGET}/release/nodo-tui
	vbin target/${RUST_TARGET}/release/nodo-healthd
	# Runs last inside every service sandbox, including those of nodo-caddy, nodo-ddns and nodo-mdns.
	vbin target/${RUST_TARGET}/release/nodo-confine
	# The system update client. nodo-snapshot, built alongside, is for publishers and stays out.
	vbin target/${RUST_TARGET}/release/nodo-sysupdate
	# The hardware test's GPU probe: lists Vulkan devices and runs a small compute shader. It
	# opens the Vulkan loader at run time, so it needs nothing on boards without one.
	vbin target/${RUST_TARGET}/release/nodo-gpu-check
	# Package panels on the built-in screen. Not enabled here: boards with a screen enable it in
	# place of tty1's login prompt.
	vbin target/${RUST_TARGET}/release/nodo-screen
	# The same panels drawn in pixels straight to the display through KMS, with JetBrains Mono (Open
	# Font License) as the screen's typeface. Boards with a screen enable it in place of tty1's login
	# prompt; nodo-screen stays for terminals, over SSH.
	vbin target/${RUST_TARGET}/release/nodo-gui
	vinstall crates/nodo-gui/ui/fonts/JetBrainsMono-Regular.ttf 644 usr/share/fonts/nodo
	vinstall crates/nodo-gui/ui/fonts/JetBrainsMono-Bold.ttf 644 usr/share/fonts/nodo
	vinstall crates/nodo-gui/ui/fonts/OFL.txt 644 usr/share/licenses/nodo-tools OFL-JetBrainsMono.txt
	# libxkbcommon's keymaps would otherwise bring xkbcomp and libX11 (the file says why).
	vinstall ${FILESDIR}/xbps.d/nodo-no-x11.conf 644 usr/share/xbps.d
	# The screen's Shut down button: a root service that only stops services and turns the device
	# off, asked over a socket that only root and _nodo_screen may open.
	vbin target/${RUST_TARGET}/release/nodo-power
	# The screen's console font: Terminus with the glyphs the screen draws added, renamed as the
	# Open Font License requires of a modified font.
	# nodo-screen-font runs here, on the build machine, so it is built again for the build machine
	# (the build above was for the target); it is not installed.
	_host=$(rustc -vV | sed -n 's/^host: //p')
	env -u CARGO_BUILD_TARGET -u RUSTFLAGS CC=gcc \
		cargo build --release --locked --target "$_host" -p nodo-screen-font
	vmkdir usr/share/nodo
	target/${_host}/release/nodo-screen-font /usr/share/kbd/consolefonts/ter-v32n.psf.gz \
		${DESTDIR}/usr/share/nodo/nodo-screen-16x32.psf.gz
	vinstall /usr/share/licenses/terminus-font/OFL.txt 644 usr/share/licenses/nodo-tools OFL-nodo-screen-16x32.txt
	# The logo on the built-in screen while the device starts and stops. Its runit hooks do
	# nothing on boards without nodo-screen enabled.
	vbin target/${RUST_TARGET}/release/nodo-splash
	vinstall ${FILESDIR}/nodo-splash/01-nodo-splash.sh 644 etc/runit/core-services
	vinstall ${FILESDIR}/nodo-splash/05-nodo-splash.sh 644 etc/runit/shutdown.d
	# Before runit's general stop, which kills a service after 7 seconds: waits for the node and any
	# package that declares a longer stop, on every shutdown that the Shut down button did not start.
	vinstall ${FILESDIR}/shutdown/06-nodo-long-stop.sh 644 etc/runit/shutdown.d
	# A fixed Ethernet address from the board serial, before dhcpcd starts (stable IP, port forwards).
	vinstall ${FILESDIR}/network/nodo-fixed-mac 755 usr/libexec/nodo
	vinstall ${FILESDIR}/network/03-nodo-fixed-mac.sh 644 etc/runit/core-services
	# Opens nodo-tui for interactive SSH logins.
	vinstall ${FILESDIR}/profile/nodo-tui.sh 644 etc/profile.d
	vsv nodo-helper
	vsv nodo-healthd
	vsv nodo-autoupdate
	# The schedule for system snapshot updates: it checks and reports, and applies only when
	# the owner turned automatic system updates on.
	vsv nodo-systemupdate
	# wpa_supplicant for the owner's Wi-Fi. Not enabled: the helper links it when the owner turns
	# Wi-Fi on. wpa_supplicant itself comes with the board's image.
	vsv nodo-wifi
	vsv nodo-screen
	vsv nodo-gui
	vsv nodo-power
	# Settings knowledge for the base image's node, until cuprated-service ships its own.
	vinstall ${FILESDIR}/cuprated/manifest.toml 644 usr/share/nodo/manifests cuprated.toml
	vinstall ${FILESDIR}/cuprated/settings.lua 644 usr/share/nodo/packages/cuprated
	vinstall ${FILESDIR}/cuprated/Cuprated.toml.in 644 usr/share/nodo/packages/cuprated
	vinstall ${FILESDIR}/cuprated/panels/sync.lua 644 usr/share/nodo/packages/cuprated/panels
	# The app feed every device starts with, its key pinned from the start (docs/FEED.md).
	vinstall ${FILESDIR}/default-feeds.toml 644 usr/share/nodo
	# System snapshots: the update server and the keys and channel this device trusts.
	vinstall ${FILESDIR}/system-update.toml 644 etc/nodo
	vinstall ${FILESDIR}/snapshot-pins.toml 644 usr/share/nodo
	vlicense LICENSE
}

# Template file for 'mk-pay'
#
# A feed app, not a base system package: everything lands in /opt/nodo/apps/mk-pay and the
# package must pass nodo-feed's gate, so there are no system accounts, services, licenses under
# /usr or install scripts here. The device creates the user, sandbox and firewall from
# manifest.toml.
pkgname=mk-pay
version=0.1.0pre20261113
revision=1
_commit=7d8d458598e04d865b8b37214936efc555893b61
# Monokulo builds on nightly Rust, unpinned upstream. This is the nightly published the day of
# _commit, so the toolchain is fixed by date and checksum rather than by whatever is current.
_nightly=2026-11-07
_node=24.22.2
archs="aarch64 x86_64"
hostmakedepends="gcc cmake make pkg-config clang xz"
short_desc="Self-hosted watch-only Monero payment gateway"
maintainer="monokulo-nodo <noreply@localhost>"
# Upstream declares no license yet. Nothing is installed under /usr/share/licenses because a feed
# package may only write inside its own directory.
license="custom:none-declared"
homepage="https://github.com/OceanEilonwy/monokulo-pay"

_dist=https://static.rust-lang.org/dist/${_nightly}
case "$XBPS_MACHINE" in
	x86_64)
		_host=x86_64-unknown-linux-gnu
		_nodearch=x64
		_rustc_sum=3640f7f7bf840e0125771d0618744929809240cd2b8e6cbc98f848efcf288337
		_cargo_sum=ba7ae2159e90b2128418b91fb93a26bb76ffe72311d8c7255095458e2549b3e9
		_std_sum=7b85b56d7169c076fa1e31de5a4e3052ff8400d887dd80f47aa69579e15c85f8
		_node_sum=48cc0e21e048790e54c0cf5749c2725005313d652651c40b7a21feb9697aaf75
		;;
	aarch64)
		_host=aarch64-unknown-linux-gnu
		_nodearch=arm64
		_rustc_sum=e748c5afe5c74476ef74aeac07df4b9a0e72d8eb97a9861d308268669ec3e1ff
		_cargo_sum=73a59e3749c61ae0936d89774b8c11e883c1ff5195b196c6e5eecf29b44a9fb9
		_std_sum=d0e22de77a8447490c359e7d6398feb21d4b5988c4c469c1b802d809f2d40610
		_node_sum=eb187837a2230d4047161ac0be008584e16b46f726e9c9490ee35dc6b17d9ba8
		;;
	*) broken="no pinned toolchain for build machine $XBPS_MACHINE" ;;
esac

distfiles="https://github.com/OceanEilonwy/monokulo-pay/archive/${_commit}.tar.gz
 ${_dist}/rustc-nightly-${_host}.tar.xz
 ${_dist}/cargo-nightly-${_host}.tar.xz
 ${_dist}/rust-std-nightly-${_host}.tar.xz
 ${_dist}/rust-std-nightly-wasm32-unknown-unknown.tar.xz
 https://nodejs.org/dist/v${_node}/node-v${_node}-linux-${_nodearch}.tar.xz"
checksum="54f55e1d6fe7ccecdd0025da42c6525fb338e7f09aa6ea885fcd2cccb30e0987
 ${_rustc_sum}
 ${_cargo_sum}
 ${_std_sum}
 40fb6838d01bb1477f40820fd727b60a195bca0790f9a1aa8f94f471f3f85814
 ${_node_sum}"

# Cross builds also need the target's standard library.
if [ "$CROSS_BUILD" ] && [ "$XBPS_TARGET_MACHINE" = aarch64 ]; then
	distfiles+=" ${_dist}/rust-std-nightly-aarch64-unknown-linux-gnu.tar.xz"
	checksum+=" d0e22de77a8447490c359e7d6398feb21d4b5988c4c469c1b802d809f2d40610"
elif [ "$CROSS_BUILD" ] && [ "$XBPS_TARGET_MACHINE" = x86_64 ]; then
	distfiles+=" ${_dist}/rust-std-nightly-x86_64-unknown-linux-gnu.tar.xz"
	checksum+=" 7b85b56d7169c076fa1e31de5a4e3052ff8400d887dd80f47aa69579e15c85f8"
fi

# Several distfiles extract side by side into $wrksrc; the source is one of them.
build_wrksrc="monokulo-pay-${_commit}"
_app=opt/nodo/apps/mk-pay

post_extract() {
	# The toolchain components are rustup's own dist tarballs, merged into one prefix.
	local d
	mkdir -p "${wrksrc}/toolchain"
	for d in "${wrksrc}"/rustc-nightly-* "${wrksrc}"/cargo-nightly-* "${wrksrc}"/rust-std-nightly-*; do
		[ -d "$d" ] || continue
		"$d"/install.sh --prefix="${wrksrc}/toolchain" --disable-ldconfig >/dev/null
	done
}

_toolchain_env() {
	_tc="${wrksrc}/toolchain"
	_node_dir="${wrksrc}/node-v${_node}-linux-${_nodearch}"
	export PATH="${_tc}/bin:${_node_dir}/bin:${PATH}"
	export RUSTC="${_tc}/bin/rustc"
	export CARGO="${_tc}/bin/cargo"
	export CARGO_HOME="${XBPS_HOSTDIR}/monokulo-cargo"
	export CARGO_BUILD_JOBS="${XBPS_MAKEJOBS}"
	export npm_config_cache="${XBPS_HOSTDIR}/monokulo-npm"
	export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
	export MONOKULO_GIT_COMMIT="${_commit}"
	# Build scripts run on the build machine and need its compiler, not the target's.
	export HOST_CC=gcc HOST_CXX=g++ CC_wasm32_unknown_unknown=clang
	# This is not build_style=cargo, so the linker for each triple is set here. Without it
	# rustc calls `cc`, which the build environment does not have.
	local t="${RUST_TARGET^^}" b="${RUST_BUILD^^}"
	t="${t//-/_}"
	b="${b//-/_}"
	if [ "$CROSS_BUILD" ]; then
		# The cross profile points --sysroot at Void's own target std, which is stable Rust and
		# not what this toolchain needs. Unset rather than empty, so .cargo/config.toml still
		# applies its wasm32 flags.
		unset RUSTFLAGS
		export "CARGO_TARGET_${b}_LINKER=gcc"
		export PKG_CONFIG_ALLOW_CROSS=1
	fi
	export "CARGO_TARGET_${t}_LINKER=${CC}"
}

do_configure() {
	_toolchain_env
	"${_tc}/bin/rustc" -vV
	node --version
	npm ci --no-audit --no-fund
}

do_build() {
	_toolchain_env
	"${CARGO}" build --release --locked --target "${RUST_TARGET}" -p monokulo --bin monokulo-pay
}

do_install() {
	vmkdir ${_app}/bin 755
	vmkdir ${_app}/libexec 755
	install -m 755 target/${RUST_TARGET}/release/monokulo-pay "${DESTDIR}/${_app}/libexec/monokulo-pay"
	install -m 755 "${FILESDIR}/monokulo-pay" "${DESTDIR}/${_app}/bin/monokulo-pay"
	install -m 644 "${FILESDIR}/manifest.toml" "${DESTDIR}/${_app}/manifest.toml"
	sed -i "s/@VERSION@/${version}/" "${DESTDIR}/${_app}/manifest.toml"
	install -m 644 "${FILESDIR}/settings.lua" "${DESTDIR}/${_app}/settings.lua"
}

#!/bin/sh
exec 2>&1
exec </dev/null

# The helper writes the generated config here and reloads it through the admin socket.
config=/var/lib/nodo-web/caddy.json
[ -r "$config" ] || config=/usr/share/nodo-caddy/empty.json
install -d -o _caddy -g _caddy -m 750 /run/nodo-web
# The web GUI (nodo-tools) listens on a Unix socket in this directory, which is its account's and
# lets only Caddy's group in. nodo-web-gui's run script makes it the same way; it is made here as
# well so that the bind below is there even when Caddy starts first.
if id -u _nodo_webgui >/dev/null 2>&1; then
	install -d -m 2750 -o _nodo_webgui -g _caddy /run/nodo-web-gui
fi
# Each proxied request holds two sockets. dash, Void's /bin/sh, supports -n.
# shellcheck disable=SC3045
ulimit -n 8192

# Caddy needs Unix sockets for its admin endpoint and app upstreams. nodo-confine keeps it away
# from abstract sockets outside its sandbox, and --disable-userns from nested user namespaces.
exec chpst -u _caddy:_caddy bwrap \
	--ro-bind /usr /usr \
	--symlink usr/bin /bin \
	--symlink usr/lib /lib \
	--symlink usr/lib /lib64 \
	--ro-bind-try /etc/resolv.conf /etc/resolv.conf \
	--ro-bind-try /etc/hosts /etc/hosts \
	--ro-bind-try /etc/ssl /etc/ssl \
	--ro-bind /var/lib/nodo-web /var/lib/nodo-web \
	--ro-bind-try /run/apps /run/apps \
	--ro-bind-try /run/nodo-web-gui /run/nodo-web-gui \
	--bind /run/nodo-web /run/nodo-web \
	--bind /var/lib/caddy /var/lib/caddy \
	--proc /proc \
	--dev /dev \
	--tmpfs /tmp \
	--setenv HOME /var/lib/caddy \
	--setenv XDG_DATA_HOME /var/lib/caddy/data \
	--setenv XDG_CONFIG_HOME /var/lib/caddy/config \
	--unshare-user --disable-userns \
	--unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup-try \
	--new-session --die-with-parent \
	/usr/bin/nodo-confine --unix -- /usr/bin/nodo-caddy run --config "$config"

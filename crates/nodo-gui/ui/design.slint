component Sources inherits Rectangle {
    Bar {
        tab: 1;
        lock: 0;
    }
    VerticalLayout {
        x: 48px;
        y: 160px;
        width: 1824px;
        spacing: 24px;
        Crumbs {
            trail: ["Apps", "Get apps", "Sources"];
            VerticalLayout {
                alignment: center;
                Btn {
                    label: "Add a source";
                    w: 320px;
                    locked: true;
                }
            }
        }
        for s[i] in [
            { name: "monokulo", tag: "built in", addr: "nodo.monokulo.com/feed  ·  5 apps", on: true, problem: "" },
            { name: "Alice's apps", tag: "", addr: "apps.alice.example/feed  ·  2 apps", on: true, problem: "✕  Couldn't reach it since yesterday" },
            { name: "Test builds", tag: "", addr: "192.168.1.40:8080/feed  ·  1 app", on: false, problem: "" }
        ]: Card {
            height: s.problem != "" ? 220px : 170px;
            background: i == 1 ? DP.raised : DP.card;
            VerticalLayout {
                padding-left: 40px;
                padding-right: 40px;
                padding-top: 28px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 20px;
                    height: 60px;
                    T {
                        text: s.name;
                        font-size: 32px;
                        font-weight: 700;
                        color: DP.bright;
                    }
                    if s.tag != "": T {
                        text: s.tag;
                        font-size: 24px;
                        color: DP.dim;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            on: s.on;
                        }
                    }
                    Btn {
                        label: "Remove";
                        kind: 1;
                        w: 200px;
                        locked: true;
                    }
                }
                T {
                    text: s.addr;
                    color: DP.dim;
                }
                if s.problem != "": HorizontalLayout {
                    spacing: 24px;
                    T {
                        text: s.problem;
                        color: DP.err;
                    }
                    T {
                        text: "Try again";
                        color: DP.accent;
                        font-weight: 700;
                    }
                }
            }
        }
    }
}


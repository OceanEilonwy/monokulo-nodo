# Template file for 'library'
#
# The Library, a home catalogue for books, music, films and kit with full-text and meaning-based
# search. A feed app, not a base system package: everything lands in /opt/nodo/apps/library. It is
# one Rust binary (axum on hyper, maud, htmx) with its pages, styles and fonts compiled in and
# SQLite bundled, run as a service behind the web proxy. The small sentence-embedding model
# (BAAI/bge-small-en-v1.5, about 130 MB) is not packaged: the app downloads it into its data
# directory on first start, which is one reason it asks for internet access.
#
# Upstream builds on stable (1.88 or newer); this uses packages/monokulo's pinned nightly, like
# kringle, so the toolchain distfiles and their checksums are shared. Cargo.lock pins every crate
# and the build runs with --locked.
pkgname=library
version=0.1.0
revision=2
_commit=d75ac40272dc6bf729dd9bb9679149a4d3c3baa7
_nightly=2026-11-07
archs="aarch64 x86_64"
hostmakedepends="gcc make pkg-config clang xz"
short_desc="Home library catalogue with meaning-based search"
maintainer="monokulo-nodo <noreply@localhost>"
# Nothing is installed under /usr/share/licenses because a feed package may only write inside its
# own directory.
license="MIT"
homepage="https://github.com/OceanEilonwy/library"

_dist=https://static.rust-lang.org/dist/${_nightly}
case "$XBPS_MACHINE" in
	x86_64)
		_host=x86_64-unknown-linux-gnu
		_rustc_sum=3640f7f7bf840e0125771d0618744929809240cd2b8e6cbc98f848efcf288337
		_cargo_sum=ba7ae2159e90b2128418b91fb93a26bb76ffe72311d8c7255095458e2549b3e9
		_std_sum=7b85b56d7169c076fa1e31de5a4e3052ff8400d887dd80f47aa69579e15c85f8
		;;
	aarch64)
		_host=aarch64-unknown-linux-gnu
		_rustc_sum=e748c5afe5c74476ef74aeac07df4b9a0e72d8eb97a9861d308268669ec3e1ff
		_cargo_sum=73a59e3749c61ae0936d89774b8c11e883c1ff5195b196c6e5eecf29b44a9fb9
		_std_sum=d0e22de77a8447490c359e7d6398feb21d4b5988c4c469c1b802d809f2d40610
		;;
	*) broken="no pinned toolchain for build machine $XBPS_MACHINE" ;;
esac

distfiles="https://github.com/OceanEilonwy/library/archive/${_commit}.tar.gz
 ${_dist}/rustc-nightly-${_host}.tar.xz
 ${_dist}/cargo-nightly-${_host}.tar.xz
 ${_dist}/rust-std-nightly-${_host}.tar.xz"
checksum="8608027b18e1ba1a33399ffc7e99aee2a5374278e9b842e52e1aa98b2ee4d092
 ${_rustc_sum}
 ${_cargo_sum}
 ${_std_sum}"

if [ "$CROSS_BUILD" ] && [ "$XBPS_TARGET_MACHINE" = aarch64 ]; then
	distfiles+=" ${_dist}/rust-std-nightly-aarch64-unknown-linux-gnu.tar.xz"
	checksum+=" d0e22de77a8447490c359e7d6398feb21d4b5988c4c469c1b802d809f2d40610"
elif [ "$CROSS_BUILD" ] && [ "$XBPS_TARGET_MACHINE" = x86_64 ]; then
	distfiles+=" ${_dist}/rust-std-nightly-x86_64-unknown-linux-gnu.tar.xz"
	checksum+=" 7b85b56d7169c076fa1e31de5a4e3052ff8400d887dd80f47aa69579e15c85f8"
fi

# Library Rip, the desktop disc ripper the library offers on /ripper. The GitHub release
# (rip-v<_ripver>, built on Linux, Windows and macOS runners by the library's rip-release workflow)
# is bundled as is, so the page works without anyone copying builds in. Copy the hashes from the
# release's SHA256SUMS when bumping _ripver.
_ripver=0.1.0
_ripbase=https://github.com/OceanEilonwy/library/releases/download/rip-v${_ripver}
_ripfiles="library-rip-${_ripver}-linux-x86_64.tar.gz
 library-rip-${_ripver}-windows-x86_64.zip
 library-rip-${_ripver}-macos-arm64.dmg
 library-rip-${_ripver}-macos-x86_64.dmg"
_ripsums="c778078ae419ece07d1d4960d5c9f4411069fcca640152aa0904d2eb52692e39
 b97aebf5d89be573b1ac10ca5b8af42c0997cd145ca1350ac2d6cc2d55a57c4e
 4b86390b0eb9f7c9495a129de47b4c3cd7de1af1747e43ec1b20b0abc7910b5c
 f8457a96dec77e82e2570c8bf8e4c6a9957f3a7fe6eec143b7685b580f7e71c0"
for _f in $_ripfiles; do distfiles+=" ${_ripbase}/${_f}"; done
checksum+=" ${_ripsums//$'\n'/}"
skip_extraction="${_ripfiles//$'\n'/}"

build_wrksrc="library-${_commit}"
_app=opt/nodo/apps/library

post_extract() {
	local d
	mkdir -p "${wrksrc}/toolchain"
	for d in "${wrksrc}"/rustc-nightly-* "${wrksrc}"/cargo-nightly-* "${wrksrc}"/rust-std-nightly-*; do
		[ -d "$d" ] || continue
		"$d"/install.sh --prefix="${wrksrc}/toolchain" --disable-ldconfig >/dev/null
	done
}

_toolchain_env() {
	_tc="${wrksrc}/toolchain"
	export PATH="${_tc}/bin:${PATH}"
	export RUSTC="${_tc}/bin/rustc"
	export CARGO="${_tc}/bin/cargo"
	export CARGO_HOME="${XBPS_HOSTDIR}/feed-cargo"
	export CARGO_BUILD_JOBS="${XBPS_MAKEJOBS}"
	export HOST_CC=gcc HOST_CXX=g++
	local t="${RUST_TARGET^^}" b="${RUST_BUILD^^}"
	t="${t//-/_}"
	b="${b//-/_}"
	if [ "$CROSS_BUILD" ]; then
		unset RUSTFLAGS
		export "CARGO_TARGET_${b}_LINKER=gcc"
		export PKG_CONFIG_ALLOW_CROSS=1
	fi
	export "CARGO_TARGET_${t}_LINKER=${CC}"
}

do_configure() {
	_toolchain_env
	"${_tc}/bin/rustc" -vV
}

do_build() {
	_toolchain_env
	"${CARGO}" build --release --locked --target "${RUST_TARGET}" --bin library
}

do_install() {
	vmkdir ${_app}/bin 755
	vmkdir ${_app}/libexec 755
	install -m 755 target/${RUST_TARGET}/release/library "${DESTDIR}/${_app}/libexec/library"
	install -m 755 "${FILESDIR}/library" "${DESTDIR}/${_app}/bin/library"
	install -m 644 "${FILESDIR}/manifest.toml" "${DESTDIR}/${_app}/manifest.toml"
	sed -i "s/@VERSION@/${version}/" "${DESTDIR}/${_app}/manifest.toml"
	# The library looks for downloads/library-rip next to its program.
	vmkdir ${_app}/libexec/downloads/library-rip 755
	for _f in $_ripfiles; do
		install -m 644 "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_f}" \
			"${DESTDIR}/${_app}/libexec/downloads/library-rip/${_f}"
	done
	install -m 644 "${FILESDIR}/settings.lua" "${DESTDIR}/${_app}/settings.lua"
}

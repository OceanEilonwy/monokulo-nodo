#!/bin/sh
exec 2>&1
exec </dev/null

# The helper writes this, owned by _nododdns with mode 600, while a site is public. It holds the
# provider credentials, so it lives in memory and exists only while the device is unlocked.
dir=/run/nodo/secrets/nodo-ddns
config=$dir/config.toml
if [ ! -r "$config" ]; then
	echo "waiting: $config does not exist, because the device is locked or no site is public"
	sleep 30
	exit 1
fi

exec chpst -u _nododdns:_nododdns bwrap \
	--ro-bind /usr /usr \
	--symlink usr/bin /bin \
	--symlink usr/lib /lib \
	--symlink usr/lib /lib64 \
	--ro-bind "$dir" "$dir" \
	--ro-bind-try /etc/resolv.conf /etc/resolv.conf \
	--ro-bind-try /etc/hosts /etc/hosts \
	--ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf \
	--ro-bind-try /etc/ssl /etc/ssl \
	--bind /var/lib/nodo-ddns /var/lib/nodo-ddns \
	--proc /proc \
	--dev /dev \
	--tmpfs /tmp \
	--setenv HOME /var/lib/nodo-ddns \
	--unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup-try \
	--new-session --die-with-parent \
	/usr/bin/nodo-ddns --config "$config"

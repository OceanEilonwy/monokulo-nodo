        alignment: center;
        Switch {
            on: root.on;
            toggled => {
                root.toggled();
            }
        }
    }
}

export component ConsoleView inherits Rectangle {
    in property <int> page;
    // 0 none, 1 unlock, 2 keyboard, 3 pin, 4 reset, 5 dialog, 6 wifi, 7 logo, 8 web
    in property <int> overlay;
    in property <CStatus> status;
    in property <CWeb> web;
    in property <CServices> services;
    in property <CNetwork> network;
    in property <CDevice> device;
    in property <CKeyboard> keyboard;
    in property <CPin> pin;
    in property <CReset> reset;
    in property <CDialog> dialog;
    in property <CWifiSheet> wifi;
    in property <CLogo> logo;
    in property <string> toast;
    in property <bool> toast-error;
    callback act(string);
    callback key(string);
    background: C.ground;

    Rail {
        x: 0;
        y: 0;
        height: parent.height;
        page: root.page;
        act(id) => {
            root.act(id);
        }
    }
    Rectangle {
        x: 208px;
        y: 0;
        width: parent.width - 208px;
        height: parent.height;
        if page == 0: StatusPage {
            s: root.status;
            web: root.web;
            act(id) => {
                root.act(id);
            }
        }
        if page == 1: ServicesPage {
            s: root.services;
            web: root.web.qr;
            act(id) => {
                root.act(id);
            }
        }
        if page == 2: NetworkPage {
            n: root.network;
            web: root.web.qr;
            act(id) => {
                root.act(id);
            }
        }
        if page == 3: DevicePage {
            d: root.device;
            web: root.web.qr;
            act(id) => {
                root.act(id);
            }
        }
    }

    if overlay == 1: UnlockView {
        kb: root.keyboard;
        key(k) => {
            root.key(k);
        }
    }
    if overlay == 2: KeyboardView {
        kb: root.keyboard;
        key(k) => {
            root.key(k);
        }
    }
    if overlay == 3: PinView {
        pin: root.pin;
        key(k) => {
            root.key(k);
        }
    }
    if overlay == 4: ResetView {
        r: root.reset;
        act(id) => {
            root.act(id);
        }
    }
    if overlay == 5: Sheet {
        title: root.dialog.title;
        danger: root.dialog.danger;
        closable: false;
        T {
            text: root.dialog.text;
            color: C.dim;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 24px;
            if root.dialog.yes != "": Btn {
                label: "Cancel";
                clicked => {
                    root.act("dialog-close");
                }
            }
            Btn {
                label: root.dialog.yes != "" ? root.dialog.yes : "OK";
                kind: root.dialog.danger && root.dialog.yes != "" ? 3 : 1;
                clicked => {
                    root.act(root.dialog.yes != "" ? "dialog-yes" : "dialog-close");
                }
            }
        }
    }
    if overlay == 6: Sheet {
        title: "Wi-Fi";
        close => {
            root.act("sheet-close");
        }
        if root.wifi.available: SwitchRow {
            label: "Wi-Fi";
            on: root.wifi.on;
            toggled => {
                root.act("wifi-toggle");
            }
        }
        if root.wifi.note != "": T {
            text: root.wifi.note;
            font-size: 30px;
            color: C.dim;
            wrap: word-wrap;
        }
        for w in root.wifi.rows: Rectangle {
            height: Touch.row;
            border-radius: 28px;
            background: wt.pressed ? C.selected : C.raised;
            HorizontalLayout {
                padding-left: 32px;
                padding-right: 28px;
                spacing: 24px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    T {
                        text: w.ssid;
                        font-weight: 600;
                        overflow: elide;
                    }
                }
                T {
                    text: w.note;
                    font-size: 30px;
                    color: C.dim;
                }
                if w.joined: VerticalLayout {
                    alignment: center;
                    Chip {
                        label: "Joined";
                        tone: 1;
                    }
                }
                if !w.joined: VerticalLayout {
                    alignment: center;
                    Icon {
                        d: Icons.chevron;
                        size: 40px;
                        weight: 2.4;
                        tint: C.chevron;
                    }
                }
            }
            wt := TouchArea {
                enabled: !w.joined;
                clicked => {
                    root.act("wifi-join:" + w.ssid);
                }
            }
        }
    }
    if overlay == 7: Sheet {
        title: "Nodo logo tile";
        close => {
            root.act("sheet-close");
        }
        HorizontalLayout {
            spacing: 12px;
            for o[i] in ["Drawn", "Text"]: Rectangle {
                height: Touch.segment;
                border-radius: 24px;
                background: (i == 1) == root.logo.text ? C.accent : C.key;
                T {
                    text: o;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: (i == 1) == root.logo.text ? C.on-accent : #e6e6e6;
                }
                TouchArea {
                    clicked => {
                        root.act("logo-style:" + i);
                    }
                }
            }
        }
        SwitchRow {
            label: "Shimmer";
            note: "The boot splash's glint, on the text style";
            on: root.logo.shimmer;
            toggled => {
                root.act("logo-shimmer");
            }
        }
        SwitchRow {
            label: "Show the name";
            on: root.logo.name;
            toggled => {
                root.act("logo-name");
            }
        }
    }
    if overlay == 8: Sheet {
        title: "Manage via web";
        close => {
            root.act("sheet-close");
        }
        HorizontalLayout {
            spacing: 48px;
            Qr {
                code: root.web.qr;
                side: 520px;
                pad: 24px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 16px;
                T {
                    text: root.web.url;
                    font-family: C.mono;
                    font-size: 44px;
                    font-weight: 700;
                    wrap: char-wrap;
                }
                T {
                    text: root.web.host;
                    font-family: C.mono;
                    font-size: 30px;
                    color: C.dim;
                    wrap: word-wrap;
                }
                T {
                    text: root.web.note;
                    font-size: 30px;
                    color: C.dim;
                    wrap: word-wrap;
                }
            }
        }
    }

    if root.toast != "": Rectangle {
        x: 208px + (parent.width - 208px - self.width) / 2;
        y: parent.height - 152px;
        width: min(1500px, toast-text.preferred-width + 96px);
        height: 104px;
        border-radius: 32px;
        background: root.toast-error ? C.neg-fill : C.button;
        border-width: 2px;
        border-color: root.toast-error ? #6a2a24 : C.mark;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000a0;
        toast-text := T {
            text: root.toast;
            font-size: 34px;
            horizontal-alignment: center;
            color: root.toast-error ? C.neg : C.fg;
        }
    }
}

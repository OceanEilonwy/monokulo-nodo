# FriendlyElec NanoPC-T6N from microSD, on the mainline longterm kernel instead of the vendor 6.1.
# Everything except the kernel package, the console name and Vulkan matches boards/nanopc-t6n, so
# the two cards can be compared on the same board. docs/MAINLINE_KERNEL.md explains each difference.
BOARD_ARCH=aarch64
# The platform: the helper, TUI, health daemon and nodo-confine (nodo-tools), and the web proxy,
# dynamic DNS and local address services. The helper enables the web services when sites ask for
# them. Monokulo is a feed app, installed through the helper, so it is not part of the image.
# Vulkan for apps granted the GPU: Void's loader and panvk, a headless Mesa with only that driver
# (packages/mesa-panvk). Only this card: panvk needs panthor, and the vendor 6.1 kernel has Arm's
# kbase instead.
# The built-in screen's panels (docs/SCREEN.md) draw on tty1 with Terminus's 512-glyph console font,
# loaded with kbd's setfont, for its block characters.
BOARD_PACKAGES="linux-mainline-rk3588 linux-firmware-network nodo-tools nodo-caddy nodo-ddns nodo-localnet eudev alsa-utils wpa_supplicant bluez dbus v4l-utils vulkan-loader mesa-panvk kbd terminus-font"
# Started at boot, besides the base services: the helper the TUI talks to, the health daemon and
# the automatic update timer, which does nothing until the owner enables updates for a package.
BOARD_SERVICES="nodo-helper nodo-healthd nodo-autoupdate udevd nodo-sound nodo-screen nodo-power"
# The screen's panels take tty1, the console on the built-in screen, from its login prompt.
BOARD_DISABLE_SERVICES="agetty-tty1"
# Kept the same as the vendor board, so both images are configured the same way.
BOARD_STAGE_KERNEL=linux6.18
BOARD_STAGE_CONSOLE=ttyAMA0
BOARD_QEMU="qemu-system-aarch64 -M virt -cpu max"
BOARD_STAGE1_MODULES="virtio_blk"
# Mainline names the debug UART ttyS2. The vendor kernel calls it ttyFIQ0.
BOARD_CONSOLE=ttyS2
BOARD_ROOT=/dev/mmcblk0p8
BOARD_FSTAB_EXTRA="PARTLABEL=NODO_BLOCKCHAIN /media/monero xfs defaults,noatime,nofail 0 0"
# Mainline can load compressed firmware, but the files stay the same as on the vendor card.
BOARD_DECOMPRESS_FIRMWARE=1
BOARD_MKDIRS="/media/monero"
BOARD_DRACUT_DRIVERS=""
BOARD_FIRMWARE_IGNORE="linux sof-firmware alsa-firmware linux-firmware linux-firmware-amd linux-firmware-broadcom linux-firmware-intel linux-firmware-nvidia linux-firmware-qualcomm"
# Firmware: only what this board's hardware asks for, from linux-firmware-network. The Realtek
# 2.5GbE port, the Mali-G610's CSF firmware (arm/mali/arch10.8 links to arch10.10) for panthor,
# and Wi-Fi and Bluetooth firmware for the M.2 and USB cards the kernel has drivers for: Realtek
# rtw88/rtw89 and their Bluetooth, MediaTek MT7921/MT7922/MT7925, Intel AX200/AX210/BE200 and
# Qualcomm WCN6855/WCN7850. For rtw89 and Intel only the firmware versions 6.18 loads are kept
# (plus the rtw89 files 6.1 names), and not the QCNCM865 variant of WCN7850. About 50 MiB, kept
# once, uncompressed (BOARD_DECOMPRESS_FIRMWARE).
# The bootloader reads the kernel from its own partition, so the Image the package keeps in
# /boot for QEMU is left out.
BOARD_NOEXTRACT="/usr/lib/firmware/* !/usr/lib/firmware/rtl_nic/rtl8125* !/usr/lib/firmware/arm/mali/arch10.* !/usr/lib/firmware/rtw88/* !/usr/lib/firmware/rtw89/rtw8851b_fw.bin* !/usr/lib/firmware/rtw89/rtw8852a_fw.bin* !/usr/lib/firmware/rtw89/rtw8852b_fw-1.bin* !/usr/lib/firmware/rtw89/rtw8852bt_fw.bin* !/usr/lib/firmware/rtw89/rtw8852c_fw.bin* !/usr/lib/firmware/rtw89/rtw8852c_fw-2.bin* !/usr/lib/firmware/rtw89/rtw8922a_fw-4.bin* !/usr/lib/firmware/rtl_bt/* !/usr/lib/firmware/mediatek/*MT7961* !/usr/lib/firmware/mediatek/*MT7922* !/usr/lib/firmware/mediatek/mt7925/* !/usr/lib/firmware/*iwlwifi-cc-a0-77.* !/usr/lib/firmware/*iwlwifi-ty-a0-gf-a0-89.* !/usr/lib/firmware/*iwlwifi-ty-a0-gf-a0.pnvm* !/usr/lib/firmware/*iwlwifi-gl-c0-fm-c0-10[01].* !/usr/lib/firmware/*iwlwifi-gl-c0-fm-c0.pnvm* !/usr/lib/firmware/intel/ibt-20-* !/usr/lib/firmware/intel/ibt-0040-0041.* !/usr/lib/firmware/intel/ibt-0041-0041.* !/usr/lib/firmware/intel/ibt-0291-0291.* !/usr/lib/firmware/intel/ibt-0093-0041.ddc* !/usr/lib/firmware/intel/ibt-0093-0291.sfi* !/usr/lib/firmware/ath11k/WCN6855/* !/usr/lib/firmware/ath12k/WCN7850/* /usr/lib/firmware/ath12k/WCN7850/hw2.0/ncm865/* !/usr/lib/firmware/qca/hpbtfw21* !/usr/lib/firmware/qca/hpnv21* !/usr/lib/firmware/qca/hmtbtfw20* !/usr/lib/firmware/qca/hmtnv20* /boot/vmlinuz-*"
# The same pinned FriendlyElec bootloader as the vendor board.
BOARD_SDFUSE_COMMIT=430f0c0
# Size budgets, which scripts/build-image.sh enforces. The root filesystem measured 517 MiB on
# 2026-11-09 (500 MiB before Vulkan: mesa-panvk 15.2 MiB, vulkan-loader 0.6 MiB and libdrm;
# 395 MiB before the hardware drivers' modules, about 52 MiB of firmware, eudev, ALSA,
# wpa_supplicant, bluez and v4l-utils); the budget is about 10% above. The kernel budget
# is the kernel partition, 40 MiB; kernel.img is 21.8 MiB. There is no initramfs to measure.
BOARD_MAX_ROOTFS_MB=570
BOARD_MAX_KERNEL_MB=40

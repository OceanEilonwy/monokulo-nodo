// Touch screen GUI v2: the same features and look as the first touch boards, but with proper
// Slint widgets instead of terminal idioms. Inter for the interface, JetBrains Mono only for
// addresses, keys and logs. Mock data only; rendered by `nodo-gui --screenshot <scene> <png>`.

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";

global G {
    out property <color> ground: #000000;
    out property <color> surface: #0C0E10;
    out property <color> card: #15181C;
    out property <color> raised: #20252A;
    out property <color> hover: #2A3036;
    out property <color> pressed: #343B42;
    out property <color> field: #0A0C0E;
    out property <color> line: #2A3036;
    out property <color> edge: #FFFFFF12;
    out property <color> fg: #E4E6E8;
    out property <color> bright: #F7F8F9;
    out property <color> dim: #9AA2A9;
    out property <color> faint: #656D74;
    out property <color> accent: #F2A33A;
    out property <color> accent-hover: #F6B358;
    out property <color> accent-press: #D98D25;
    out property <color> on-accent: #17130D;
    out property <color> ok: #6FD6B3;
    out property <color> ok-fill: #10251E;
    out property <color> err: #FF8A7A;
    out property <color> err-fill: #2C1613;
    out property <color> info: #86BEFF;
    out property <color> info-fill: #111D2B;
    out property <string> mono: "JetBrains Mono";
    // tone: 0 dim, 1 accent, 2 ok, 3 err, 4 fg, 5 info
    public pure function tone-color(t: int) -> color {
        t == 1 ? self.accent : t == 2 ? self.ok : t == 3 ? self.err : t == 4 ? self.fg : t == 5 ? self.info : self.dim
    }
}

export struct GR {
    t: string,
    s: string,
    v: string,
    tone: int,
    chev: bool,
    hover: bool,
    mono: bool,
    sw: int,
}

component Tx inherits Text {
    color: G.fg;
    font-size: 26px;
    vertical-alignment: center;
}

component Sym inherits Text {
    font-family: G.mono;
    color: G.fg;
    font-size: 28px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// kind: 0 primary, 1 secondary, 2 destructive, 3 ghost (text). state: 0 rest, 1 hover, 2 pressed, 3 disabled
component GButton inherits Rectangle {
    in property <string> label;
    in property <int> kind: 0;
    in property <int> state: 0;
    in property <string> icon;
    in property <length> w: 240px;
    in property <bool> lock: false;
    width: w;
    height: 80px;
    border-radius: 20px;
    background: state == 3 ? (kind == 0 ? #3A3226 : G.card)
        : kind == 0 ? (state == 2 ? G.accent-press : state == 1 ? G.accent-hover : G.accent)
        : kind == 1 ? (state == 2 ? G.pressed : state == 1 ? G.hover : G.raised)
        : kind == 2 ? (state == 2 ? #4A2520 : state == 1 ? #3A1D19 : G.err-fill)
        : (state >= 1 && state <= 2 ? G.raised : transparent);
    border-width: kind == 2 ? 2px : kind == 1 ? 1px : 0px;
    border-color: kind == 2 ? #A8574C : G.edge;
    drop-shadow-blur: kind == 0 && state < 2 ? 18px : 0px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #F2A33A30;
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        if lock: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 26px;
                Rectangle {
                    x: 4px;
                    y: 0;
                    width: 14px;
                    height: 16px;
                    border-radius: 7px;
                    border-width: 3px;
                    border-color: kind == 0 ? G.on-accent : G.dim;
                }
                Rectangle {
                    x: 0;
                    y: 10px;
                    width: 22px;
                    height: 16px;
                    border-radius: 4px;
                    background: kind == 0 ? G.on-accent : G.dim;
                }
            }
        }
        if icon != "": Sym {
            text: icon;
            font-size: 26px;
            color: kind == 0 ? G.on-accent : kind == 2 ? G.err : G.bright;
        }
        Tx {
            text: label;
            font-size: 26px;
            font-weight: 600;
            color: state == 3 ? G.faint : kind == 0 ? G.on-accent : kind == 2 ? G.err : kind == 3 ? G.accent : G.bright;
        }
    }
}

component GCard inherits Rectangle {
    background: G.card;
    border-radius: 28px;
    border-width: 1px;
    border-color: G.edge;
}

component GSwitch inherits Rectangle {
    in property <bool> on;
    width: 92px;
    height: 52px;
    border-radius: 26px;
    background: on ? G.accent : G.raised;
    border-width: on ? 0px : 1px;
    border-color: G.line;
    Rectangle {
        x: on ? parent.width - 48px : 4px;
        y: 4px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: on ? #FFFFFF : G.dim;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000060;
        drop-shadow-offset-y: 2px;
    }
}

// A list row: title over subtitle on the left, value, then a chevron or a switch (sw 1 off, 2 on).
component GRow inherits Rectangle {
    in property <GR> r;
    in property <bool> last;
    height: 104px;
    background: r.hover ? G.hover : transparent;
    border-radius: 18px;
    HorizontalLayout {
        padding-left: 28px;
        padding-right: 24px;
        spacing: 24px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Tx {
                text: r.t;
                font-size: 27px;
                font-weight: 600;
                color: G.bright;
            }
            if r.s != "": Tx {
                text: r.s;
                font-size: 22px;
                color: G.dim;
                font-family: r.mono ? G.mono : "Inter";
                overflow: elide;
            }
        }
        if r.v != "": Tx {
            text: r.v;
            font-size: 24px;
            font-weight: 500;
            color: G.tone-color(r.tone);
        }
        if r.sw > 0: VerticalLayout {
            alignment: center;
            GSwitch {
                on: r.sw == 2;
            }
        }
        if r.chev: Sym {
            text: "›";
            font-size: 40px;
            color: G.faint;
            width: 28px;
        }
    }
    if !last: Rectangle {
        x: 28px;
        y: parent.height - 1px;
        width: parent.width - 56px;
        height: 1px;
        background: G.line;
    }
}

component GList inherits GCard {
    in property <[GR]> rows;
    height: rows.length * 104px + 16px;
    VerticalLayout {
        padding: 8px;
        for r[i] in rows: GRow {
            r: r;
            last: i == rows.length - 1;
        }
    }
}

// A text input: label above, focus ring and glow, placeholder, inline error, mono for addresses.
component GInput inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder;
    in property <bool> focused;
    in property <string> error;
    in property <string> help;
    in property <bool> mono;
    in property <bool> secret;
    in property <string> suffix;
    in property <string> trailing;
    spacing: 10px;
    if label != "": Tx {
        text: label;
        font-size: 22px;
        font-weight: 500;
        color: G.dim;
        height: 30px;
    }
    Rectangle {
        height: 80px;
        border-radius: 18px;
        background: G.field;
        border-width: focused || error != "" ? 3px : 1px;
        border-color: error != "" ? G.err : focused ? G.accent : G.line;
        drop-shadow-blur: focused ? 16px : 0px;
        drop-shadow-color: error != "" ? #FF8A7A30 : #F2A33A38;
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 20px;
            spacing: 4px;
            Tx {
                text: value != "" ? (secret ? "••••••••••" : value) : placeholder;
                color: value != "" ? G.bright : G.faint;
                font-family: mono && value != "" ? G.mono : "Inter";
                font-size: mono && value != "" ? 24px : 26px;
                overflow: elide;
            }
            if focused: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 3px;
                    height: 36px;
                    background: G.accent;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if suffix != "": Tx {
                text: suffix;
                color: G.dim;
                font-family: G.mono;
                font-size: 24px;
            }
            if trailing != "": Tx {
                text: trailing;
                color: G.accent;
                font-size: 24px;
                font-weight: 600;
            }
        }
    }
    if error != "" || help != "": Tx {
        text: error != "" ? "✕  " + error : help;
        font-size: 21px;
        color: error != "" ? G.err : G.dim;
        height: 28px;
    }
}

// A dropdown's closed state.
component GCombo inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <bool> open;
    spacing: 10px;
    if label != "": Tx {
        text: label;
        font-size: 22px;
        font-weight: 500;
        color: G.dim;
        height: 30px;
    }
    Rectangle {
        height: 80px;
        border-radius: 18px;
        background: open ? G.raised : G.surface;
        border-width: open ? 3px : 1px;
        border-color: open ? G.accent : G.line;
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            spacing: 14px;
            Tx {
                text: value;
                color: G.bright;
                font-weight: 500;
            }
            if sub != "": Tx {
                text: sub;
                color: G.dim;
                font-size: 22px;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Sym {
                text: open ? "▴" : "▾";
                color: G.dim;
                font-size: 26px;
            }
        }
    }
}

// An open dropdown's popup, drawn over everything at its absolute place.
component GMenu inherits Rectangle {
    in property <[GR]> items;
    in property <int> selected;
    height: items.length * 88px + 16px;
    border-radius: 20px;
    background: G.raised;
    border-width: 1px;
    border-color: #FFFFFF1E;
    drop-shadow-blur: 40px;
    drop-shadow-offset-y: 16px;
    drop-shadow-color: #000000C0;
    VerticalLayout {
        padding: 8px;
        for it[i] in items: Rectangle {
            height: 88px;
            border-radius: 14px;
            background: it.hover ? G.hover : transparent;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                Sym {
                    text: i == selected ? "✓" : "";
                    color: G.accent;
                    width: 32px;
                }
                Tx {
                    text: it.t;
                    color: it.tone == 0 ? G.bright : G.tone-color(it.tone);
                    font-weight: 500;
                }
                Tx {
                    text: it.s;
                    color: G.dim;
                    font-size: 22px;
                    horizontal-stretch: 1;
                }
                Tx {
                    text: it.v;
                    color: G.faint;
                    font-size: 22px;
                }
            }
        }
    }
}

component GSegmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    height: 72px;
    border-radius: 20px;
    background: G.field;
    border-width: 1px;
    border-color: G.line;
    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        for o[i] in options: Rectangle {
            border-radius: 15px;
            background: i == selected ? G.raised : transparent;
            border-width: i == selected ? 1px : 0px;
            border-color: #FFFFFF1E;
            Tx {
                text: o;
                horizontal-alignment: center;
                font-size: 24px;
                font-weight: i == selected ? 600 : 500;
                color: i == selected ? G.bright : G.dim;
            }
        }
    }
}

component GStepper inherits Rectangle {
    in property <string> value;
    width: 300px;
    height: 80px;
    border-radius: 18px;
    background: G.field;
    border-width: 1px;
    border-color: G.line;
    HorizontalLayout {
        Rectangle {
            width: 88px;
            Sym {
                text: "−";
                font-size: 34px;
                color: G.bright;
            }
        }
        Rectangle {
            width: 1px;
            background: G.line;
        }
        Tx {
            text: value;
            horizontal-alignment: center;
            font-weight: 600;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 1px;
            background: G.line;
        }
        Rectangle {
            width: 88px;
            Sym {
                text: "+";
                font-size: 34px;
                color: G.bright;
            }
        }
    }
}

component GSlider inherits Rectangle {
    in property <float> value;
    height: 56px;
    Rectangle {
        y: (parent.height - 10px) / 2;
        height: 10px;
        border-radius: 5px;
        background: G.raised;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 10px) / 2;
        width: parent.width * value;
        height: 10px;
        border-radius: 5px;
        background: G.accent;
    }
    Rectangle {
        x: parent.width * value - 26px;
        y: (parent.height - 52px) / 2;
        width: 52px;
        height: 52px;
        border-radius: 26px;
        background: #FFFFFF;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 3px;
    }
}

component GRadioCard inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <bool> selected;
    border-radius: 24px;
    background: selected ? #2A2116 : G.surface;
    border-width: selected ? 3px : 1px;
    border-color: selected ? G.accent : G.line;
    @children
    HorizontalLayout {
        x: 24px;
        y: parent.height - 92px;
        width: parent.width - 48px;
        height: 72px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                border-width: 3px;
                border-color: selected ? G.accent : G.dim;
                if selected: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: G.accent;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Tx {
                text: title;
                font-weight: 600;
                color: G.bright;
            }
            Tx {
                text: sub;
                font-size: 21px;
                color: G.dim;
            }
        }
    }
}

component GProgress inherits Rectangle {
    in property <float> value;
    height: 12px;
    border-radius: 6px;
    background: G.raised;
    Rectangle {
        x: 0;
        width: parent.width * value;
        border-radius: 6px;
        background: G.accent;
    }
}

component GSpinner inherits Rectangle {
    width: 44px;
    height: 44px;
    Path {
        width: 44px;
        height: 44px;
        viewbox-width: 44;
        viewbox-height: 44;
        stroke: G.raised;
        stroke-width: 5px;
        commands: "M 22 3 A 19 19 0 1 1 21.9 3";
    }
    Path {
        width: 44px;
        height: 44px;
        viewbox-width: 44;
        viewbox-height: 44;
        stroke: G.accent;
        stroke-width: 5px;
        commands: "M 22 3 A 19 19 0 0 1 41 22";
    }
}

component GToast inherits Rectangle {
    in property <string> text;
    in property <int> tone: 2;
    in property <string> action;
    x: (1920px - self.width) / 2;
    y: 940px;
    width: 900px;
    height: 88px;
    border-radius: 24px;
    background: G.raised;
    border-width: 1px;
    border-color: #FFFFFF1E;
    drop-shadow-blur: 36px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: #000000D0;
    HorizontalLayout {
        padding-left: 28px;
        padding-right: 20px;
        spacing: 18px;
        Sym {
            text: tone == 3 ? "✕" : "✓";
            color: G.tone-color(tone);
            width: 32px;
        }
        Tx {
            text: root.text;
            color: G.bright;
            font-weight: 500;
            horizontal-stretch: 1;
        }
        if action != "": Tx {
            text: action;
            color: G.accent;
            font-weight: 600;
        }
    }
}

// The dimmed backdrop under a sheet or dialog.
component GScrim inherits Rectangle {
    x: 0;
    y: 0;
    width: 1920px;
    height: 1080px;
    background: #000000B8;
}

component GDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <int> tone: 4;
    in property <string> primary;
    in property <string> secondary;
    in property <bool> destructive;
    in property <length> h: 520px;
    x: (1920px - 1040px) / 2;
    y: (1080px - h) / 2;
    width: 1040px;
    height: h;
    border-radius: 32px;
    background: G.card;
    border-width: 1px;
    border-color: #FFFFFF1E;
    drop-shadow-blur: 60px;
    drop-shadow-offset-y: 20px;
    drop-shadow-color: #000000E0;
    VerticalLayout {
        padding: 52px;
        spacing: 22px;
        Tx {
            text: title;
            font-size: 38px;
            font-weight: 700;
            color: tone == 4 ? G.bright : G.tone-color(tone);
        }
        Tx {
            text: body;
            color: G.dim;
            wrap: word-wrap;
            vertical-alignment: top;
        }
        @children
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            spacing: 20px;
            alignment: end;
            if secondary != "": GButton {
                label: secondary;
                kind: 1;
                w: 240px;
            }
            if primary != "": GButton {
                label: primary;
                kind: destructive ? 2 : 0;
                w: destructive ? 300px : 280px;
            }
        }
    }
}

component GKey inherits Rectangle {
    in property <string> label;
    in property <length> kw: 140px;
    in property <bool> dark;
    in property <bool> down;
    width: kw;
    height: 86px;
    border-radius: 16px;
    background: down ? G.accent : dark ? #191D21 : #2B3137;
    drop-shadow-blur: 0px;
    border-width: 1px;
    border-color: #FFFFFF10;
    Tx {
        text: label;
        horizontal-alignment: center;
        font-size: label.character-count > 1 ? 24px : 32px;
        font-weight: 500;
        color: down ? G.on-accent : G.bright;
    }
}

component GKeyboard inherits Rectangle {
    x: 0;
    y: 1080px - 420px;
    width: 1920px;
    height: 420px;
    background: #0B0D0F;
    drop-shadow-blur: 40px;
    drop-shadow-color: #000000;
    Rectangle {
        y: 0;
        height: 1px;
        background: #FFFFFF14;
    }
    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        alignment: center;
        HorizontalLayout {
            spacing: 12px;
            alignment: center;
            for k in ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"]: GKey {
                label: k;
                down: k == "e";
            }
            GKey {
                label: "⌫";
                kw: 180px;
                dark: true;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            alignment: center;
            for k in ["a", "s", "d", "f", "g", "h", "j", "k", "l"]: GKey {
                label: k;
            }
            GKey {
                label: "Done";
                kw: 250px;
                dark: true;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            alignment: center;
            GKey {
                label: "⇧";
                kw: 180px;
                dark: true;
            }
            for k in ["z", "x", "c", "v", "b", "n", "m", ".", "/"]: GKey {
                label: k;
            }
            GKey {
                label: "-";
                kw: 110px;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            alignment: center;
            GKey {
                label: "123";
                kw: 180px;
                dark: true;
            }
            GKey {
                label: ":";
                kw: 110px;
            }
            GKey {
                label: "space";
                kw: 800px;
            }
            GKey {
                label: "Paste";
                kw: 200px;
                dark: true;
            }
            GKey {
                label: "‹  ›";
                kw: 180px;
                dark: true;
            }
        }
    }
}

// The top bar: back to the wallpaper, the four tabs as one segmented control, lock chip, power.
// lock: 0 locked, 1 unlocked, 2 no PIN
component GNav inherits Rectangle {
    in property <int> tab;
    in property <int> lock;
    x: 0;
    y: 0;
    width: 1920px;
    height: 128px;
    background: G.surface;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: G.line;
    }
    HorizontalLayout {
        padding-left: 40px;
        padding-right: 40px;
        padding-top: 24px;
        padding-bottom: 24px;
        spacing: 20px;
        Rectangle {
            width: 200px;
            border-radius: 20px;
            background: G.raised;
            border-width: 1px;
            border-color: G.edge;
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                Sym {
                    text: "‹";
                    font-size: 36px;
                    color: G.bright;
                }
                Tx {
                    text: "Screen";
                    font-weight: 600;
                    color: G.bright;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 880px;
            border-radius: 22px;
            background: G.field;
            border-width: 1px;
            border-color: G.line;
            HorizontalLayout {
                padding: 6px;
                spacing: 6px;
                for name[i] in ["Home", "Apps", "Web", "System"]: Rectangle {
                    border-radius: 17px;
                    background: i == tab ? G.accent : transparent;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Tx {
                            text: name;
                            font-size: 27px;
                            font-weight: 600;
                            color: i == tab ? G.on-accent : G.fg;
                        }
                        if i == 1: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 17px;
                                background: i == tab ? G.on-accent : G.accent;
                                Tx {
                                    text: "2";
                                    horizontal-alignment: center;
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: i == tab ? G.accent : G.on-accent;
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Rectangle {
            width: lock == 2 ? 300px : 220px;
            border-radius: 20px;
            background: lock == 1 ? G.ok-fill : G.raised;
            border-width: 1px;
            border-color: lock == 1 ? #6FD6B355 : G.edge;
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 26px;
                        Rectangle {
                            x: lock == 1 ? 8px : 4px;
                            y: 0;
                            width: 14px;
                            height: 16px;
                            border-radius: 7px;
                            border-width: 3px;
                            border-color: lock == 1 ? G.ok : G.dim;
                        }
                        Rectangle {
                            x: 0;
                            y: 10px;
                            width: 22px;
                            height: 16px;
                            border-radius: 4px;
                            background: lock == 1 ? G.ok : G.dim;
                        }
                    }
                }
                Tx {
                    text: lock == 0 ? "Locked" : lock == 1 ? "Unlocked" : "No screen PIN";
                    font-size: 24px;
                    font-weight: 600;
                    color: lock == 1 ? G.ok : G.dim;
                }
            }
        }
        Rectangle {
            width: 80px;
            border-radius: 20px;
            background: G.err-fill;
            border-width: 1px;
            border-color: #A8574C;
            Sym {
                text: "⏻";
                font-size: 32px;
                color: G.err;
            }
        }
    }
}

// The page header under the bar: crumbs, a big title, a line of description, actions on the right.
component GHeader inherits Rectangle {
    in property <[string]> crumbs;
    in property <string> title;
    in property <string> sub;
    x: 64px;
    y: 152px;
    width: 1792px;
    height: sub != "" ? 150px : 116px;
    VerticalLayout {
        spacing: 4px;
        alignment: start;
        if crumbs.length > 0: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            height: 34px;
            for c[i] in crumbs: HorizontalLayout {
                spacing: 10px;
                Tx {
                    text: c;
                    font-size: 22px;
                    font-weight: 500;
                    color: G.accent;
                }
                Tx {
                    text: "›";
                    font-size: 22px;
                    color: G.faint;
                }
            }
        }
        Tx {
            text: title;
            font-size: 46px;
            font-weight: 700;
            color: G.bright;
            height: 60px;
        }
        if sub != "": Tx {
            text: sub;
            font-size: 24px;
            color: G.dim;
            height: 36px;
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 16px;
        height: parent.height;
        VerticalLayout {
            alignment: end;
            padding-bottom: 6px;
            HorizontalLayout {
                spacing: 16px;
                @children
            }
        }
    }
}

// The area under the header, for cards.
component GBody inherits VerticalLayout {
    in property <length> top: 300px;
    x: 64px;
    y: top;
    width: 1792px;
    spacing: 24px;
    alignment: start;
}

// A card with a title, body text and buttons inside it.
component GInfo inherits GCard {
    in property <string> title;
    in property <string> body;
    in property <int> tone: 4;
    in property <string> icon;
    in property <string> primary;
    in property <string> secondary;
    in property <bool> destructive;
    in property <bool> lock;
    in property <length> h: 200px;
    height: h;
    HorizontalLayout {
        padding: 36px;
        padding-left: 40px;
        spacing: 28px;
        if icon != "": VerticalLayout {
            alignment: start;
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 32px;
                background: tone == 3 ? G.err-fill : tone == 1 ? #2A2116 : tone == 2 ? G.ok-fill : G.info-fill;
                Sym {
                    text: icon;
                    font-size: 30px;
                    color: G.tone-color(tone);
                }
            }
        }
        VerticalLayout {
            spacing: 10px;
            alignment: center;
            horizontal-stretch: 1;
            Tx {
                text: title;
                font-size: 32px;
                font-weight: 700;
                color: tone == 4 ? G.bright : G.tone-color(tone);
            }
            if body != "": Tx {
                text: body;
                font-size: 24px;
                color: G.dim;
                wrap: word-wrap;
            }
            @children
        }
        if primary != "" || secondary != "": VerticalLayout {
            alignment: end;
            HorizontalLayout {
                spacing: 16px;
                if secondary != "": GButton {
                    label: secondary;
                    kind: 1;
                    w: 230px;
                }
                if primary != "": GButton {
                    label: primary;
                    kind: destructive ? 2 : 0;
                    lock: lock;
                    w: primary.character-count > 12 ? 340px : 240px;
                }
            }
        }
    }
}

component Note inherits Text {
    x: 64px;
    y: 1040px;
    width: 1792px;
    height: 30px;
    font-size: 20px;
    color: G.faint;
    vertical-alignment: center;
}

component Logo2 inherits Image {
    source: @image-url("logo.svg");
    image-fit: contain;
}

component PinPad inherits Rectangle {
    in property <int> state;
    GScrim { }
    Rectangle {
        x: (1920px - 760px) / 2;
        y: 70px;
        width: 760px;
        height: 940px;
        border-radius: 36px;
        background: G.card;
        border-width: 1px;
        border-color: #FFFFFF1E;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: #000000E0;
        VerticalLayout {
            padding: 44px;
            spacing: 18px;
            Tx {
                horizontal-alignment: center;
                height: 54px;
                text: state == 2 ? "Too many tries" : "Enter the screen PIN";
                font-size: 36px;
                font-weight: 700;
                color: state == 2 ? G.err : G.bright;
            }
            Tx {
                horizontal-alignment: center;
                height: 34px;
                text: state == 0 ? "to update mk-pay" : "That's not the PIN. Try again.";
                font-size: 24px;
                color: state == 1 ? G.err : G.dim;
            }
            HorizontalLayout {
                height: 64px;
                alignment: center;
                spacing: 24px;
                for d[i] in [0, 1, 2, 3, 4, 5]: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        background: state == 0 && i < 4 ? G.accent : transparent;
                        border-width: 3px;
                        border-color: state == 1 ? G.err : state == 0 && i < 4 ? G.accent : G.faint;
                    }
                }
            }
            if state < 2: HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    spacing: 16px;
                    for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]: HorizontalLayout {
                        spacing: 16px;
                        for k in row: Rectangle {
                            width: 180px;
                            height: 132px;
                            border-radius: 66px;
                            background: k == "5" && state == 0 ? G.pressed : G.raised;
                            Tx {
                                text: k;
                                horizontal-alignment: center;
                                font-size: 48px;
                                font-weight: 500;
                                color: G.bright;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        Rectangle {
                            width: 180px;
                            height: 132px;
                            Tx {
                                text: "Cancel";
                                horizontal-alignment: center;
                                font-size: 26px;
                                font-weight: 600;
                                color: G.accent;
                            }
                        }
                        Rectangle {
                            width: 180px;
                            height: 132px;
                            border-radius: 66px;
                            background: G.raised;
                            Tx {
                                text: "0";
                                horizontal-alignment: center;
                                font-size: 48px;
                                font-weight: 500;
                                color: G.bright;
                            }
                        }
                        Rectangle {
                            width: 180px;
                            height: 132px;
                            Sym {
                                text: "⌫";
                                font-size: 40px;
                                color: G.dim;
                            }
                        }
                    }
                }
            }
            if state == 2: VerticalLayout {
                padding-top: 80px;
                spacing: 50px;
                Tx {
                    horizontal-alignment: center;
                    text: "Looking around still works; only changes wait.";
                    color: G.dim;
                }
                HorizontalLayout {
                    alignment: center;
                    GButton {
                        label: "OK";
                        kind: 1;
                        w: 240px;
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ wallpapers


// A setting that takes its value from another app: shows the linked app and what it provides.
// state: 0 linked and running, 1 open, 2 manual address, 3 nothing offers it
component RefField inherits VerticalLayout {
    in property <string> label;
    in property <int> state;
    spacing: 10px;
    Tx { text: label; font-size: 22px; font-weight: 500; color: G.dim; height: 30px; }
    Rectangle {
        height: 104px;
        border-radius: 20px;
        background: state == 1 ? G.raised : G.surface;
        border-width: state == 1 ? 3px : 1px;
        border-color: state == 1 ? G.accent : state == 3 ? #F2A33A80 : G.line;
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 24px;
            spacing: 20px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 16px;
                    background: state == 2 ? G.info-fill : state == 3 ? #2A2116 : #2A1A0C;
                    if state == 0 || state == 1: Logo2 { x: 8px; y: 8px; width: 48px; height: 48px; }
                    if state == 2: Sym { text: "⌁"; color: G.info; font-size: 30px; }
                    if state == 3: Sym { text: "?"; color: G.accent; font-size: 30px; }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Tx { text: state == 2 ? "An address you entered" : state == 3 ? "No app offers a Monero node yet" : "cuprated"; font-size: 27px; font-weight: 600; color: state == 3 ? G.accent : G.bright; }
                    if state <= 1: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 130px;
                            height: 32px;
                            border-radius: 16px;
                            background: G.ok-fill;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: G.ok; } }
                                Tx { text: "Running"; font-size: 19px; font-weight: 600; color: G.ok; }
                            }
                        }
                    }
                }
                Tx {
                    text: state == 2 ? "http://192.168.1.50:18081 · reached a Monero node at height 3,478,012" : state == 3 ? "Install one, or enter a node's address yourself" : "Monero node on this Nodo · 127.0.0.1:18081";
                    font-size: 22px;
                    color: G.dim;
                    font-family: state == 3 ? "Inter" : G.mono;
                }
            }
            Tx { text: state == 3 ? "Choose" : "Change"; font-size: 24px; font-weight: 600; color: G.accent; }
            Sym { text: state == 1 ? "▴" : "▾"; color: G.dim; font-size: 26px; }
        }
    }
}

// The reference picker's popup: compatible providers, grouped.
component RefMenu inherits Rectangle {
    in property <bool> empty;
    border-radius: 24px;
    background: G.raised;
    border-width: 1px;
    border-color: #FFFFFF1E;
    drop-shadow-blur: 48px;
    drop-shadow-offset-y: 18px;
    drop-shadow-color: #000000D0;
    VerticalLayout {
        padding: 12px;
        spacing: 2px;
        alignment: start;
        if !empty: Tx { text: "ON THIS NODO"; font-size: 19px; font-weight: 700; letter-spacing: 1.2px; color: G.faint; height: 44px; x: 20px; }
        if !empty: Rectangle {
            height: 96px;
            border-radius: 16px;
            background: #2A2116;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 24px;
                spacing: 18px;
                Sym { text: "✓"; color: G.accent; width: 32px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Tx { text: "cuprated"; font-size: 26px; font-weight: 600; color: G.bright; }
                        VerticalLayout { alignment: center; Rectangle { width: 150px; height: 30px; border-radius: 15px; background: G.accent; Tx { text: "Recommended"; font-size: 18px; font-weight: 700; color: G.on-accent; horizontal-alignment: center; } } }
                    }
                    Tx { text: "Monero node · 127.0.0.1:18081"; font-size: 21px; color: G.dim; font-family: G.mono; }
                }
                Tx { text: "● Running"; font-size: 21px; color: G.ok; }
            }
        }
        if !empty: Rectangle {
            height: 96px;
            border-radius: 16px;
            opacity: 0.55;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 24px;
                spacing: 18px;
                Rectangle { width: 32px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Tx { text: "monerod"; font-size: 26px; font-weight: 600; color: G.bright; }
                    Tx { text: "Stopped · start it in Apps to use it here"; font-size: 21px; color: G.dim; }
                }
                Tx { text: "○ Stopped"; font-size: 21px; color: G.dim; }
            }
        }
        if !empty: Rectangle { height: 1px; background: G.line; }
        if !empty: Tx { text: "NOT INSTALLED YET"; font-size: 19px; font-weight: 700; letter-spacing: 1.2px; color: G.faint; height: 44px; }
        if !empty: Rectangle {
            height: 96px;
            border-radius: 16px;
            background: G.pressed;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                spacing: 18px;
                Rectangle { width: 32px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Tx { text: "monero-lite"; font-size: 26px; font-weight: 600; color: G.bright; }
                    Tx { text: "A small pruned node · from monokulo · 30 GB"; font-size: 21px; color: G.dim; }
                }
                VerticalLayout { alignment: center; GButton { label: "Install"; kind: 1; w: 160px; height: 64px; } }
            }
        }
        if empty: VerticalLayout {
            padding: 24px;
            spacing: 18px;
            Tx { text: "No app on this Nodo offers a Monero node"; font-size: 28px; font-weight: 600; color: G.bright; }
            Tx { text: "cuprated is a full Monero node from your monokulo source. It takes a few days to sync."; font-size: 22px; color: G.dim; wrap: word-wrap; }
            HorizontalLayout { alignment: start; GButton { label: "Get cuprated"; w: 280px; } }
        }
        Rectangle { height: 1px; background: G.line; }
        Rectangle {
            height: 88px;
            border-radius: 16px;
            HorizontalLayout {
                padding-left: 20px;
                spacing: 18px;
                Sym { text: "⌁"; color: G.info; width: 32px; }
                Tx { text: "Enter an address myself…"; font-size: 25px; font-weight: 600; color: G.info; }
            }
        }
    }
}


// A settings gear, drawn as a vector (Material "settings" outline, Apache 2.0).
component GearIcon inherits Path {
    in property <color> tint: G.fg;
    width: 30px;
    height: 30px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: tint;
    fill-rule: evenodd;
    commands: "M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z";
}

// Four small tiles: Arrange.
component GridIcon inherits Rectangle {
    in property <color> tint: G.fg;
    width: 28px;
    height: 28px;
    for j in [0, 1, 2, 3]: Rectangle {
        x: Math.mod(j, 2) * 16px;
        y: Math.floor(j / 2) * 16px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        border-width: 2.5px;
        border-color: tint;
    }
}


// ------------------------------------------------------------------ references: one generic feature
// Any text, number or address setting may hold $(package.setting) references, alone or mixed with
// text. They show as chips: app · setting, and the value it resolves to now. Rust resolves them.

// state: 0 resolves, 1 broken (red, with why), 2 secret granted
component Chip inherits Rectangle {
    in property <string> app;
    in property <string> setting;
    in property <string> value;
    in property <int> state;
    in property <bool> selected;
    height: 56px;
    min-width: row.preferred-width + 44px;
    preferred-width: row.preferred-width + 44px;
    horizontal-stretch: 0;
    border-radius: 14px;
    background: state == 1 ? G.err-fill : selected ? #3A2C18 : #2A2116;
    border-width: selected ? 2px : 1px;
    border-color: state == 1 ? #A8574C : selected ? G.accent : #F2A33A66;
    row := HorizontalLayout {
        x: 14px;
        width: self.preferred-width;
        spacing: 8px;
        Tx { text: app; font-family: G.mono; font-size: 21px; font-weight: 700; color: state == 1 ? G.err : G.accent; }
        Tx { text: "·"; font-size: 21px; color: G.faint; }
        Tx { text: setting; font-family: G.mono; font-size: 21px; color: state == 1 ? G.err : G.bright; }
        if value != "": Tx { text: state == 1 ? "  " + value : "→ " + value + " "; font-family: state == 1 ? "Inter" : G.mono; font-size: 20px; color: state == 1 ? G.err : G.dim; }
    }
}

component InsertRef inherits Rectangle {
    width: 72px;
    height: 60px;
    border-radius: 14px;
    background: G.raised;
    border-width: 1px;
    border-color: G.edge;
    Sym { text: "{ }"; font-size: 24px; color: G.accent; }
}

// One row in the reference picker.
export struct PR {
    app: string,
    name: string,
    desc: string,
    kind: string,
    value: string,
    ok: bool,
    why: string,
    hl: bool,
    secret: bool,
    // The app's heading above its first row.
    head: bool,
}

component PickRow inherits Rectangle {
    in property <PR> r;
    height: 92px;
    border-radius: 14px;
    background: r.hl ? G.hover : transparent;
    opacity: r.ok || r.secret ? 1.0 : 0.5;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 20px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Tx { text: r.app + "." + r.name; font-family: G.mono; font-size: 24px; font-weight: 700; color: G.bright; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: kindt.preferred-width + 20px;
                        height: 28px;
                        border-radius: 8px;
                        background: G.surface;
                        border-width: 1px;
                        border-color: G.line;
                        kindt := Tx { text: r.kind; font-size: 17px; color: G.dim; horizontal-alignment: center; }
                    }
                }
                if !r.secret: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 84px;
                        height: 28px;
                        border-radius: 8px;
                        background: G.info-fill;
                        Tx { text: "public"; font-size: 17px; font-weight: 600; color: G.info; horizontal-alignment: center; }
                    }
                }
            }
            Tx { text: r.ok || r.secret ? r.desc : r.why; font-size: 20px; color: r.ok || r.secret ? G.dim : G.err; }
        }
        if !r.secret: Tx { text: r.value; font-family: G.mono; font-size: 22px; color: G.fg; }
        if r.secret: Tx { text: "Needs your approval · Grant…"; font-size: 21px; font-weight: 600; color: G.accent; }
    }
}

// The one generic picker, searchable, grouped by app. Shown as a sheet from the right.
component RefPicker inherits Rectangle {
    in property <string> target;
    in property <string> query;
    in property <string> filter;
    in property <[PR]> rows;
    in property <[PR]> secrets;
    x: 1920px - 1060px;
    y: 0;
    width: 1060px;
    height: 1080px;
    background: G.card;
    border-width: 1px;
    border-color: #FFFFFF1E;
    drop-shadow-blur: 60px;
    drop-shadow-color: #000000E0;
    VerticalLayout {
        padding: 36px;
        spacing: 16px;
        alignment: start;
        HorizontalLayout {
            height: 56px;
            Tx { text: "Insert a reference"; font-size: 34px; font-weight: 700; color: G.bright; }
            Rectangle { horizontal-stretch: 1; }
            Sym { text: "✕"; color: G.dim; width: 56px; }
        }
        Tx { text: "into " + target; font-size: 22px; color: G.dim; height: 30px; }
        GInput { value: query; placeholder: "Search apps, settings, descriptions or values"; focused: true; }
        if filter != "": Tx { text: filter; font-size: 20px; color: G.dim; height: 30px; }
        for r in rows: VerticalLayout {
            spacing: 0px;
            if r.head: Tx { text: r.app; font-size: 19px; font-weight: 700; letter-spacing: 1.2px; color: G.faint; height: 44px; vertical-alignment: bottom; }
            PickRow { r: r; }
        }
        if secrets.length > 0: VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                height: 40px;
                spacing: 10px;
                Tx { text: "SECRETS · NOT PUBLIC"; font-size: 18px; font-weight: 700; letter-spacing: 1.2px; color: G.faint; }
            }
            for r in secrets: PickRow { r: r; }
        }
    }
}

// A settings field whose value may be text, references, or both.
component RefFieldShell inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    in property <bool> focused;
    in property <bool> error;
    spacing: 10px;
    Tx { text: label; font-size: 22px; font-weight: 500; color: G.dim; height: 30px; }
    Rectangle {
        height: 80px;
        border-radius: 18px;
        background: G.field;
        border-width: focused || error ? 3px : 1px;
        border-color: error ? G.err : focused ? G.accent : G.line;
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 12px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                horizontal-stretch: 1;
                @children
            }
            VerticalLayout { alignment: center; InsertRef { } }
        }
    }
    if help != "": Tx { text: help; font-size: 21px; color: error ? G.err : G.dim; height: 28px; }
}

component MonoT inherits Text {
    font-family: G.mono;
    font-size: 24px;
    color: G.bright;
    vertical-alignment: center;
}


// A pencil (Material "edit", Apache 2.0): Type a value instead.
component PencilIcon inherits Path {
    in property <color> tint: G.accent;
    width: 26px;
    height: 26px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: tint;
    commands: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c0.39-0.39 0.39-1.02 0-1.41l-2.34-2.34c-0.39-0.39-1.02-0.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z";
}

// A long value (an address) in full: monospace, wrapping inside the field, which grows only for it.
component GLongInput inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> error;
    spacing: 10px;
    Tx { text: label; font-size: 22px; font-weight: 500; color: G.dim; height: 30px; }
    Rectangle {
        height: max(80px, longtext.preferred-height + 36px);
        border-radius: 18px;
        background: G.field;
        border-width: error != "" ? 3px : 1px;
        border-color: error != "" ? G.err : G.line;
        longtext := Text {
            x: 24px;
            y: 18px;
            width: parent.width - 48px;
            text: value;
            font-family: G.mono;
            font-size: 24px;
            color: G.bright;
            wrap: char-wrap;
        }
    }
    if error != "": Tx { text: "✕  " + error; font-size: 21px; color: G.err; height: 28px; }
}

// ------------------------------------------------------------------ the tile screen (everything is tiles)

// One grid cell is 217 px with 16 px gaps, starting at (36, 132): the real geometry (src/geometry.rs).
component TileBox inherits Rectangle {
    in property <int> cx;
    in property <int> cy;
    in property <int> cw: 2;
    in property <int> ch: 1;
    in property <string> title;
    in property <bool> selected;
    in property <bool> arranging;
    x: 36px + cx * 233px;
    y: 132px + cy * 233px;
    width: cw * 217px + (cw - 1) * 16px;
    height: ch * 217px + (ch - 1) * 16px;
    border-radius: 20px;
    border-width: selected ? 4px : 2px;
    border-color: selected ? G.accent : #3A4045;
    background: arranging && !selected ? #0A0C0E : transparent;
    if title != "": Tx {
        x: 24px;
        y: 14px;
        height: 34px;
        text: title;
        font-family: G.mono;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: 1.3px;
        color: G.dim;
    }
    @children
}

// The Nodo logo as a tile: drawn (vector) or text (the boot splash grid), centred, square.
component LogoTile inherits TileBox {
    in property <bool> text-style;
    in property <image> grid;
    property <length> side: Math.min(self.width, self.height) - (self.height > 600px ? 200px : 70px);
    if !text-style: Logo2 {
        x: (parent.width - side) / 2;
        y: (parent.height - side) / 2 - (parent.height > 600px ? 40px : 0px);
        width: side;
        height: side;
    }
    if text-style: Image {
        x: (parent.width - side) / 2;
        y: (parent.height - side) / 2 - (parent.height > 600px ? 40px : 0px);
        width: side;
        height: side;
        source: grid;
        image-rendering: pixelated;
    }
    if root.height > 600px: Tx {
        x: 0;
        y: parent.height - 120px;
        width: parent.width;
        height: 60px;
        horizontal-alignment: center;
        text: text-style ? "n o d o" : "nodo";
        font-family: text-style ? G.mono : "Inter";
        font-size: 48px;
        font-weight: 700;
        letter-spacing: text-style ? 0px : 12px;
        color: #FF6600;
    }
}

component ValueTile inherits TileBox {
    in property <string> big;
    in property <string> unit;
    in property <color> big-color: G.ok;
    in property <string> note;
    in property <float> bar: -1;
    HorizontalLayout {
        x: 24px;
        y: 56px;
        height: 90px;
        spacing: 12px;
        alignment: start;
        Tx { text: big; font-family: G.mono; font-size: parent.height > 300px ? 72px : 54px; font-weight: 700; color: big-color; }
        Tx { text: unit; font-family: G.mono; font-size: 24px; color: G.dim; vertical-alignment: bottom; }
    }
    if bar >= 0: GProgress {
        x: 24px;
        y: 160px;
        width: parent.width - 48px;
        height: 8px;
        value: bar;
    }
    Tx {
        x: 24px;
        y: parent.height - 52px;
        width: parent.width - 48px;
        height: 32px;
        text: note;
        font-family: G.mono;
        font-size: 20px;
        color: G.dim;
        overflow: elide;
    }
}

// The tile screen's top bar: resting (Manage, Arrange, Shut down) or arranging (Hide, + Add, Save).
component TileBar inherits Rectangle {
    in property <bool> arranging;
    x: 36px;
    y: 24px;
    width: 1848px;
    height: 88px;
    HorizontalLayout {
        spacing: 24px;
        if !arranging: Tx { text: "monokulo-nodo"; font-family: G.mono; font-size: 26px; font-weight: 700; }
        if !arranging: Tx { text: "192.168.1.155"; font-family: G.mono; font-size: 24px; color: G.dim; }
        if arranging: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 150px;
                height: 40px;
                background: G.accent;
                Tx { text: "Arrange"; font-family: G.mono; font-size: 26px; font-weight: 700; color: G.on-accent; horizontal-alignment: center; }
            }
        }
        if arranging: Tx { text: "Tap a tile; drag it, or its corner to resize. The gear opens its options."; font-family: G.mono; font-size: 22px; color: G.dim; }
        Rectangle { horizontal-stretch: 1; }
        if !arranging: Tx { text: "thu 13 nov  14:32"; font-family: G.mono; font-size: 26px; }
        if arranging: HorizontalLayout {
            spacing: 24px;
            for b in [{ l: "Hide", k: 0 }, { l: "+ Add panel  2", k: 0 }, { l: "Save", k: 3 }]: Rectangle {
                width: b.l.character-count > 10 ? 300px : 236px;
                border-radius: 20px;
                border-width: b.k == 3 ? 0px : 2px;
                border-color: #3A4045;
                background: b.k == 3 ? #86BEFF : transparent;
                Tx { text: b.l; font-family: G.mono; font-size: 24px; font-weight: 700; horizontal-alignment: center; color: b.k == 3 ? #0B1420 : G.fg; }
            }
        }
        if !arranging: Rectangle {
            width: 236px;
            border-radius: 20px;
            border-width: 2px;
            border-color: #3A4045;
            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                VerticalLayout { alignment: center; GearIcon { } }
                Tx { text: "Manage"; font-family: G.mono; font-size: 24px; font-weight: 700; }
            }
        }
        if !arranging: Rectangle {
            width: 236px;
            border-radius: 20px;
            border-width: 2px;
            border-color: #3A4045;
            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                VerticalLayout { alignment: center; GridIcon { } }
                Tx { text: "Arrange"; font-family: G.mono; font-size: 24px; font-weight: 700; }
            }
        }
        if !arranging: Rectangle {
            width: 236px;
            border-radius: 20px;
            border-width: 2px;
            border-color: #7A3A33;
            Tx { text: "⏻ Shut down"; font-family: G.mono; font-size: 24px; font-weight: 700; horizontal-alignment: center; color: G.err; }
        }
    }
}

// ------------------------------------------------------------------ the board

export component DesignBoard2 inherits Window {
    width: 1920px;
    height: 1080px;
    background: G.ground;
    default-font-family: "Inter";
    in property <string> scene;
    // The text logo for this scene (a glint frame for the shimmer keyframes), set by Rust.
    in property <image> text-logo;

    // ---- the tile screen: the logo is a tile like any other
    if scene == "g-tiles-logo": Rectangle {
        TileBar { }
        LogoTile { cx: 0; cy: 0; cw: 4; ch: 4; title: ""; text-style: false; }
        ValueTile { cx: 4; cy: 0; cw: 4; ch: 2; title: "MONERO NODE"; big: "63%"; unit: "synced"; big-color: G.accent; bar: 0.63; note: "2,190,400 / 3,478,000 · about 7 h"; }
        ValueTile { cx: 4; cy: 2; cw: 2; ch: 1; title: "PAYMENTS TODAY"; big: "4.82"; unit: "XMR"; note: "37 paid · 2 waiting"; }
        ValueTile { cx: 6; cy: 2; cw: 2; ch: 1; title: "BELL"; big: "Ringing"; unit: ""; note: "last 0.8 s ago"; }
        ValueTile { cx: 4; cy: 3; cw: 4; ch: 1; title: "DEVICE"; big: "48"; unit: "°C"; note: "ssd 27% · mem 6.1 / 31 GB · up 3 d"; }
    }
    if scene == "g-tiles-full" || scene == "g-tiles-full-k1" || scene == "g-tiles-full-k2" || scene == "g-tiles-full-k3": Rectangle {
        TileBar { }
        LogoTile { cx: 0; cy: 0; cw: 8; ch: 4; title: ""; text-style: true; grid: text-logo; border-width: 0px; }
        if scene != "g-tiles-full": Note {
            text: scene == "g-tiles-full-k1" ? "Shimmer keyframe 1 of 3: the glint enters top left (nodo-splash's own frames)" : scene == "g-tiles-full-k2" ? "Shimmer keyframe 2 of 3: across the hex core; the centre steps up to pale #FFE2C4" : "Shimmer keyframe 3 of 3: leaving bottom right; 1 s sweep, 3 s rest, repeating";
        }
    }
    if scene == "g-tile-settings": Rectangle {
        TileBar { arranging: true; }
        LogoTile { cx: 0; cy: 0; cw: 4; ch: 4; title: ""; text-style: true; grid: text-logo; selected: true; arranging: true; }
        ValueTile { cx: 4; cy: 0; cw: 4; ch: 2; title: "MONERO NODE"; big: "63%"; unit: "synced"; big-color: G.accent; bar: 0.63; note: "4 × 2"; arranging: true; }
        ValueTile { cx: 4; cy: 2; cw: 2; ch: 1; title: "PAYMENTS TODAY"; big: "4.82"; unit: "XMR"; note: "2 × 1"; arranging: true; }
        ValueTile { cx: 6; cy: 2; cw: 2; ch: 1; title: "BELL"; big: "Ringing"; unit: ""; note: "2 × 1"; arranging: true; }
        ValueTile { cx: 4; cy: 3; cw: 4; ch: 1; title: "DEVICE"; big: "48"; unit: "°C"; note: "4 × 1"; arranging: true; }
        // the selected tile's options button and resize grip
        Rectangle {
            x: 36px + 4 * 217px + 3 * 16px - 108px;
            y: 132px + 20px;
            width: 88px;
            height: 88px;
            border-radius: 44px;
            background: G.accent;
            GearIcon { x: 22px; y: 22px; width: 44px; height: 44px; tint: G.on-accent; }
        }
        Rectangle {
            x: 36px + 4 * 217px + 3 * 16px - 104px;
            y: 132px + 4 * 217px + 3 * 16px - 104px;
            width: 104px;
            height: 104px;
            border-radius: 20px;
            background: #2A2116;
            Sym { text: "⇲"; font-size: 46px; color: G.accent; }
        }
        GScrim { opacity: 0.7; }
        Rectangle {
            x: 1920px - 760px;
            y: 0;
            width: 760px;
            height: 1080px;
            background: G.card;
            border-width: 1px;
            border-color: #FFFFFF1E;
            drop-shadow-blur: 60px;
            drop-shadow-color: #000000E0;
            VerticalLayout {
                padding: 48px;
                spacing: 26px;
                alignment: start;
                Tx { text: "Nodo logo"; font-size: 40px; font-weight: 700; color: G.bright; height: 56px; }
                Tx { text: "Built in · 4 × 4 · any size from 2 × 2 to the whole screen"; font-size: 22px; color: G.dim; height: 32px; }
                VerticalLayout {
                    spacing: 12px;
                    Tx { text: "Style"; font-size: 22px; font-weight: 500; color: G.dim; height: 30px; }
                    GSegmented { options: ["Drawn", "Text, as at boot"]; selected: 1; }
                }
                HorizontalLayout {
                    height: 104px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Tx { text: "Shimmer"; font-size: 27px; font-weight: 600; color: G.bright; }
                        Tx { text: "A glint every 4 seconds, as during boot"; font-size: 22px; color: G.dim; }
                    }
                    VerticalLayout { alignment: center; GSwitch { on: true; } }
                }
                HorizontalLayout {
                    height: 104px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Tx { text: "Show the name"; font-size: 27px; font-weight: 600; color: G.bright; }
                        Tx { text: "\"n o d o\" under the logo, when the tile is tall enough"; font-size: 22px; color: G.dim; }
                    }
                    VerticalLayout { alignment: center; GSwitch { on: true; } }
                }
                Rectangle { height: 40px; }
                HorizontalLayout {
                    spacing: 20px;
                    alignment: end;
                    GButton { label: "Hide tile"; kind: 1; w: 220px; }
                    GButton { label: "Done"; w: 200px; }
                }
            }
        }
        Note { text: "Options slide in from the right (200 ms). Changes show on the tile at once; Save in the bar keeps the layout."; }
    }
    if scene == "g-tiles-add": Rectangle {
        Tx { x: 36px; y: 24px; height: 88px; text: "Add a panel"; font-family: G.mono; font-size: 36px; font-weight: 700; color: G.bright; }
        Tx { x: 420px; y: 24px; height: 88px; text: "Tap one to place it in the first free space."; font-family: G.mono; font-size: 22px; color: G.dim; }
        Rectangle {
            x: 1884px - 236px;
            y: 24px;
            width: 236px;
            height: 88px;
            border-radius: 20px;
            border-width: 2px;
            border-color: #3A4045;
            Tx { text: "Cancel"; font-family: G.mono; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
        }
        VerticalLayout {
            x: 36px;
            y: 140px;
            width: 1848px;
            spacing: 16px;
            alignment: start;
            Tx { text: "NODO"; font-family: G.mono; font-size: 22px; font-weight: 700; color: G.dim; height: 40px; letter-spacing: 1.3px; }
            for r[i] in [
                { t: "Nodo logo", d: "The logo, drawn or as at boot, with an optional shimmer", z: "2×2 to 8×4", hl: true },
                { t: "Updates", d: "What's waiting for the Nodo and your apps", z: "2×1 to 4×1", hl: false },
                { t: "Tor", d: "Whether Tor is running", z: "1×1 to 2×1", hl: false }
            ]: Rectangle {
                height: 120px;
                border-radius: 20px;
                border-width: r.hl ? 4px : 2px;
                border-color: r.hl ? G.accent : #3A4045;
                background: r.hl ? #2A2116 : transparent;
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 28px;
                    if i == 0: VerticalLayout { alignment: center; Logo2 { width: 84px; height: 84px; } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Tx { text: r.t; font-family: G.mono; font-size: 28px; font-weight: 700; color: G.bright; }
                        Tx { text: r.d; font-family: G.mono; font-size: 22px; color: G.dim; }
                    }
                    Tx { text: r.z; font-family: G.mono; font-size: 22px; color: G.dim; }
                }
            }
            Tx { text: "MK-PAY"; font-family: G.mono; font-size: 22px; font-weight: 700; color: G.dim; height: 56px; letter-spacing: 1.3px; vertical-alignment: bottom; }
            Rectangle {
                height: 120px;
                border-radius: 20px;
                border-width: 2px;
                border-color: #3A4045;
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Tx { text: "Refunds"; font-family: G.mono; font-size: 28px; font-weight: 700; color: G.bright; }
                        Tx { text: "Refunds waiting to be sent"; font-family: G.mono; font-size: 22px; color: G.dim; }
                    }
                    Tx { text: "2×1 to 4×2"; font-family: G.mono; font-size: 22px; color: G.dim; }
                }
            }
        }
    }

    // ---- Home
    if scene == "g-home": Rectangle {
        GNav { tab: 0; lock: 0; }
        GHeader { crumbs: []; title: "Good afternoon"; sub: "Thursday 13 November"; }
        GBody {
            top: 330px;
            GInfo {
                title: "2 app updates are ready";
                body: "mk-pay and kringle. Each keeps its settings and can be undone.";
                tone: 1;
                icon: "↑";
                primary: "Review updates";
                h: 180px;
            }
            GList {
                rows: [
                    { t: "cuprated", s: "Syncing the Monero chain", v: "63%", tone: 1, chev: true, hover: true },
                    { t: "mk-pay", s: "Open at https://pay.example.com", v: "Running", tone: 2, chev: true },
                    { t: "mk-lws", s: "Light wallet server", v: "Running", tone: 2, chev: true }
                ];
            }
            HorizontalLayout {
                spacing: 24px;
                height: 120px;
                for m in [{ t: "Storage", v: "27% of 2 TB" }, { t: "Temperature", v: "48 °C" }, { t: "Up", v: "3 days" }, { t: "Network", v: "192.168.1.155" }]: GCard {
                    VerticalLayout {
                        padding-left: 28px;
                        alignment: center;
                        spacing: 4px;
                        Tx { text: m.t; font-size: 22px; color: G.dim; }
                        Tx { text: m.v; font-size: 30px; font-weight: 600; color: G.bright; }
                    }
                }
            }
        }
    }
    if scene == "g-unlock": Rectangle {
        background: G.ground;
        Logo2 { x: (1920px - 220px) / 2; y: 120px; width: 220px; height: 220px; }
        GCard {
            x: (1920px - 900px) / 2;
            y: 380px;
            width: 900px;
            height: 470px;
            VerticalLayout {
                padding: 52px;
                spacing: 24px;
                Tx { text: "Unlock this Nodo"; font-size: 40px; font-weight: 700; color: G.bright; }
                Tx { text: "It restarted. Your apps' data is locked until you enter the device passphrase."; color: G.dim; wrap: word-wrap; }
                GInput { label: "Device passphrase"; value: "x"; secret: true; focused: true; trailing: "Show"; }
                HorizontalLayout { alignment: end; GButton { label: "Unlock"; w: 240px; } }
            }
        }
        Note { text: "The keyboard slides up when the box is tapped (200 ms, ease-out)."; }
    }

    // ---- Apps
    if scene == "g-apps": Rectangle {
        GNav { tab: 1; lock: 0; }
        GHeader {
            crumbs: [];
            title: "Apps";
            sub: "5 installed · 2 updates ready";
            GButton { label: "Get apps"; icon: "+"; kind: 1; w: 250px; }
        }
        GBody {
            top: 330px;
            GList {
                rows: [
                    { t: "cuprated", s: "Monero node", v: "Syncing · 63%", tone: 1, chev: true },
                    { t: "mk-pay", s: "Payments for your shop", v: "Update ready", tone: 1, chev: true, hover: true },
                    { t: "mk-lws", s: "Light wallet server", v: "Running", tone: 2, chev: true },
                    { t: "mk-bell", s: "Payment alerts", v: "Running", tone: 2, chev: true },
                    { t: "kringle", s: "Tip jar", v: "Update ready", tone: 1, chev: true }
                ];
            }
        }
    }
    if scene == "g-get-apps": Rectangle {
        GNav { tab: 1; lock: 0; }
        GHeader {
            crumbs: ["Apps"];
            title: "Get apps";
            GButton { label: "Sources"; kind: 1; w: 220px; }
        }
        GBody {
            top: 300px;
            GInput { value: "wallet"; placeholder: "Search apps"; focused: true; trailing: "Clear"; }
            GSegmented { options: ["All", "Monero", "Shop", "Tools"]; selected: 1; width: 700px; }
            GList {
                rows: [
                    { t: "feather-ws", s: "Server for Feather Wallet · from monokulo · 18 MB", v: "", chev: true, hover: true },
                    { t: "mk-lws", s: "Light wallet server for Monero wallets", v: "Installed", tone: 2, chev: true },
                    { t: "mk-pay", s: "Accept Monero in your shop", v: "Installed", tone: 2, chev: true }
                ];
            }
            Tx { text: "3 of 14 apps from your sources match."; color: G.dim; font-size: 24px; height: 40px; }
        }
    }
    if scene == "g-about": Rectangle {
        GNav { tab: 1; lock: 0; }
        GHeader { crumbs: ["Apps", "Get apps"]; title: "feather-ws"; sub: "Server for Feather Wallet · from monokulo · 18 MB"; }
        GBody {
            top: 340px;
            GInfo {
                title: "Use your own Monero node from Feather Wallet";
                body: "Lets Feather Wallet on your phone or computer use your own node instead of a stranger's, so nobody else sees which wallet is yours.";
                tone: 4;
                h: 230px;
            }
            GList {
                rows: [
                    { t: "Reads from your Monero node", s: "cuprated, on this Nodo", chev: false },
                    { t: "Uses the internet", s: "to reach other Monero nodes", chev: false },
                    { t: "Keeps 2 GB on the drive", s: "locked with your device passphrase", chev: false }
                ];
            }
            HorizontalLayout { alignment: end; GButton { label: "Install"; w: 260px; lock: true; } }
        }
    }
    if scene == "g-install": Rectangle {
        GNav { tab: 1; lock: 1; }
        GHeader { crumbs: ["Apps", "Get apps", "feather-ws"]; title: "Install feather-ws?"; }
        GBody {
            top: 300px;
            GCard {
                height: 600px;
                VerticalLayout {
                    padding: 44px;
                    spacing: 18px;
                    Tx { text: "It will be able to"; font-size: 24px; color: G.dim; }
                    for l in ["Read from your Monero node", "Use the internet to reach other Monero nodes", "Keep 2 GB on the drive, locked with your device passphrase"]: HorizontalLayout {
                        spacing: 18px;
                        height: 52px;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            y: 6px;
                            border-radius: 20px;
                            background: G.ok-fill;
                            Sym { text: "✓"; font-size: 22px; color: G.ok; }
                        }
                        Tx { text: l; }
                    }
                    Tx { text: "It can't see your other apps or their data. You can remove it at any time."; color: G.dim; font-size: 24px; }
                    Tx { text: "Show details"; color: G.accent; font-weight: 600; font-size: 24px; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: end;
                        GButton { label: "Cancel"; kind: 1; w: 220px; }
                        GButton { label: "Install"; w: 240px; state: 1; }
                    }
                }
            }
        }
        Note { text: "Primary shown in its hover state. Buttons press darker; disabled ones fade (see the button sheet)."; }
    }
    if scene == "g-installing": Rectangle {
        GNav { tab: 1; lock: 1; }
        GHeader { crumbs: ["Apps", "Get apps", "feather-ws"]; title: "Installing feather-ws"; sub: "You can leave this screen; it carries on."; }
        GBody {
            top: 340px;
            GCard {
                height: 520px;
                VerticalLayout {
                    padding: 44px;
                    spacing: 20px;
                    GProgress { value: 0.55; height: 14px; }
                    for s[i] in [

#!/bin/sh
exec 2>&1
# With a console as stdin, a service can run a command prompt and flood the log.
exec </dev/null

# A board can keep data on a separate drive. Never fall back to the system disk.
data=/var/lib/apps/shop
[ -r ./conf ] && . ./conf
DATA_MOUNT=/mnt/shop
if [ -n "${DATA_MOUNT:-}" ]; then
	if ! mountpoint -q "$DATA_MOUNT"; then
		echo "refusing to start: $DATA_MOUNT is not mounted"
		sleep 30
		exit 1
	fi
	data=$DATA_MOUNT/shop
	install -d -o _shop -g _shop -m 750 "$data"
fi

if [ ! -r /var/lib/nodo/env/shop.env ]; then
	echo "waiting: settings for shop have not been written"
	sleep 5
	exit 1
fi
set -a
. /var/lib/nodo/env/shop.env
set +a

install -d -o _shop -g _shop -m 755 /run/apps/shop

exec chpst -u _shop:_shop bwrap \
	--ro-bind /usr /usr \
	--symlink usr/bin /bin \
	--symlink usr/lib /lib \
	--symlink usr/lib /lib64 \
	--ro-bind /opt/nodo/apps/shop /opt/nodo/apps/shop \
	--ro-bind /etc/apps/shop /etc/apps/shop \
	--ro-bind-try /etc/resolv.conf /etc/resolv.conf \
	--ro-bind-try /etc/ssl /etc/ssl \
	--bind /run/apps/shop /run/apps/shop \
	--ro-bind /run/apps/cuprated /run/apps/cuprated \
	--bind "$data" /var/lib/apps/shop \
	--proc /proc \
	--dev /dev \
	--tmpfs /tmp \
	--setenv HOME /var/lib/apps/shop \
	--unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup-try \
	--new-session --die-with-parent \
	/opt/nodo/apps/shop/bin/shop.server --listen /run/apps/shop/web.sock --name 'Henry'\''s shop'

            GInfo { title: "Couldn't reach it"; body: "Nothing answered at apps.bob.example. It may be offline, or the address may be wrong."; tone: 3; icon: "✕"; secondary: "Try again"; h: 160px; }
            GInfo { title: "Its signature doesn't check out"; body: "The list wasn't signed by the key it claims. Someone may have tampered with it; the Nodo won't use it."; tone: 3; icon: "✕"; h: 160px; }
        }

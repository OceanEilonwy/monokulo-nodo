                            tone: 1;
                            clicked => {
                                root.act("change-pin");
                            }
                        }
                        ListRow {
                            icon: Icons.qr;
                            label: "Web admin address";
                            note: "Show QR";
                            clicked => {
                                root.act("web");
                            }
                        }
                    }
                }
                Group {
                    text: "NETWORK";
                }
                List {
                    VerticalLayout {
                        ListRow {
                            first: true;
                            icon: Icons.status;
                            label: "Network check";
                            note: d.network-note;
                            clicked => {
                                root.act("page:2");
                            }
                        }
                        ListRow {
                            icon: Icons.network;
                            label: "Wi-Fi";
                            note: d.wifi-note;
                            clicked => {
                                root.act("wifi");
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 12px;
                Group {
                    text: "SCREEN";
                }
                List {
                    VerticalLayout {
                        VerticalLayout {
                            padding-left: 32px;
                            padding-right: 32px;
                            padding-top: 28px;
                            padding-bottom: 24px;
                            spacing: 20px;
                            HorizontalLayout {
                                T {
                                    text: "Turn display off after";
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                }
                                T {
                                    text: d.off-label;
                                    font-size: 30px;
                                    color: C.dim;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                for o[i] in ["1 min", "5 min", "15 min", "1 hour", "Never"]: Rectangle {
                                    height: Touch.segment;
                                    border-radius: 24px;
                                    background: i == d.off-index ? C.accent : C.key;
                                    T {
                                        text: o;
                                        font-size: 30px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        color: i == d.off-index ? C.on-accent : #e6e6e6;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.act("display-off:" + i);
                                        }
                                    }
                                }
                            }
                        }
                        ListRow {
                            icon: Icons.sun;
                            label: "Brightness";
                            note: d.brightness;
                            chevron: false;
                            clicked => {
                                root.act("brightness");
                            }
                        }
                    }
                }
                Group {
                    text: "THIS DEVICE";
                }
                List {
                    VerticalLayout {
                        ListRow {
                            first: true;
                            icon: Icons.restart;
                            label: "Restart";
                            chevron: false;
                            clicked => {
                                root.act("power");
                            }
                        }
                        ListRow {
                            icon: Icons.power;
                            label: "Shut down";
                            tone: 2;
                            chevron: false;
                            clicked => {
                                root.act("power");
                            }
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------- Over the pages

// The keys of both full-screen keyboards: four rows of ten from Rust, then Shift, #+=, space
// and delete.
component Keys inherits Rectangle {
    in property <CKeyboard> kb;
    in property <length> key-h;
    in property <length> font: 48px;
    callback key(string);
    property <length> gap: 16px;
    property <length> kw: (self.width - 9 * gap) / 10;
    height: 5 * key-h + 4 * gap;
    for k[i] in kb.keys: Rectangle {
        x: Math.mod(i, 10) * (kw + gap);
        y: Math.floor(i / 10) * (key-h + gap);
        width: kw;
        height: key-h;
        border-radius: 28px;
        background: kt.pressed ? C.off : C.key;
        T {
            text: k;
            font-size: font;
            font-weight: 500;
            horizontal-alignment: center;
        }
        kt := TouchArea {
            clicked => {
                root.key("kb:" + k);
            }
        }
    }
    for f[j] in [
        { id: "shift", span: 2, at: 0 },
        { id: "symbols", span: 1, at: 2 },
        { id: "space", span: 5, at: 3 },
        { id: "back", span: 2, at: 8 },
    ]: Rectangle {
        x: f.at * (kw + gap);
        y: 4 * (key-h + gap);
        width: f.span * kw + (f.span - 1) * gap;
        height: key-h;
        border-radius: 28px;
        background: ft.pressed ? C.off : (f.id == "shift" && kb.shift) || (f.id == "symbols" && kb.symbols) ? C.accent : C.card;
        if f.id == "shift": Icon {
            d: Icons.shift;
            size: 52px;
            tint: kb.shift ? C.on-accent : C.soft;
        }
        if f.id == "back": Icon {
            d: Icons.delete;
            size: 52px;
            tint: C.soft;
        }
        if f.id == "symbols" || f.id == "space": T {
            text: f.id == "space" ? "space" : kb.symbols ? "abc" : "#+=";
            font-size: 36px;
            font-weight: 600;
            horizontal-alignment: center;
            color: f.id == "symbols" && kb.symbols ? C.on-accent : C.soft;
        }
        ft := TouchArea {
            clicked => {
                root.key(f.id);
            }
        }
    }
}

component UnlockView inherits Rectangle {
    in property <CKeyboard> kb;
    callback key(string);
    background: C.ground;
    TouchArea { }
    VerticalLayout {
        padding: 32px;
        spacing: 24px;

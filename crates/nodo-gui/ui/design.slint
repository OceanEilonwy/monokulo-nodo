component AppPage inherits Rectangle {
    Bar {
        tab: 1;
        lock: 0;
    }
    VerticalLayout {
        x: 48px;
        y: 160px;
        width: 1824px;
        spacing: 24px;
        Crumbs {
            trail: ["Apps", "mk-pay"];
            HorizontalLayout {
                spacing: 20px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    Btn {
                        label: "Restart";
                        kind: 1;
                        w: 220px;
                        locked: true;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        label: "Stop";
                        kind: 1;
                        w: 180px;
                        locked: true;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        label: "Remove…";
                        kind: 2;
                        w: 240px;
                        locked: true;
                    }
                }
            }
        }
        Card {
            height: 260px;
            VerticalLayout {
                padding: 40px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 24px;
                    T {
                        text: "mk-pay";
                        font-size: 36px;
                        font-weight: 700;
                        color: DP.bright;
                    }
                    T {
                        text: "Payments for your shop";
                        color: DP.dim;
                    }
                }
                T {

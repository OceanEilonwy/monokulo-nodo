// A card over a dimmed page: a question, or one of the sheets.
component Sheet inherits Rectangle {
    in property <string> title;
    in property <bool> closable: true;
    in property <bool> danger;
    callback close();
    background: #000000c8;
    TouchArea { }
    body := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 1240px;
        height: content.preferred-height;
        border-radius: 44px;
        background: C.card;
        border-width: 2px;
        border-color: danger ? #6a2a24 : C.mark;
        content := VerticalLayout {
            padding: 56px;
            spacing: 28px;
            HorizontalLayout {
                spacing: 24px;
                T {
                    text: title;
                    font-size: 48px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                    color: danger ? C.bad : C.fg;
                }
                if closable: Btn {
                    label: "Close";
                    clicked => {
                        root.close();
                    }
                }
            }
            @children
        }
    }
}

component SwitchRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> note;
    in property <bool> on;

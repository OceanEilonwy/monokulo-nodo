                    d: Icons.lock;
                    size: 68px;
                    tint: C.warm;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                T {
                    text: kb.title;
                    font-size: 52px;
                    font-weight: 700;
                }
                T {
                    text: kb.error != "" ? kb.error : kb.sub;
                    font-size: 30px;
                    color: kb.error != "" ? C.bad : C.dim;
                    overflow: elide;
                }
            }
        }
        HorizontalLayout {
            spacing: 24px;
            height: 128px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 32px;
                background: C.card;
